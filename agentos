usage() {
  cat <<'EOF'
agentos — operate an AgentOS Core node
  install [installer flags]   fresh install (delegates to install.sh)
  upgrade [--to <tag>|--image <ref>] [--force] [--no-chain]
                              upgrade to the stable channel, a pinned tag, or an
                              explicit (digest-pinned) image ref. Waits for a
                              quiet moment first (the node drains agent turns on
                              stop); --force restarts into a live turn anyway.
                              Run from inside the node's OWN unit cgroup (an
                              agent session it spawned), it detaches into a
                              transient unit first, so `stop` cannot behead the
                              process that asked for the upgrade.
                              A target on a newer MAJOR is applied as a chain —
                              one health-gated hop per major boundary, because
                              migrations are forward-only; --no-chain takes the
                              single jump instead (operator's call, not a default)
  autoupdate [--check]        poll the update channel and apply per policy
                              (--check: report the verdict, change nothing)
  manual-upgrade              apply the forced upgrade the core requested in
                              <signals>/upgrade-target (what `/upgrade` in chat
                              writes). Run by the manual-upgrade systemd unit,
                              not by hand — it is the unit's own cgroup that
                              lets a multi-hop chain outlive the node it
                              restarts
  rollback                    undo the last upgrade (code + database)
  backup                      take a manual backup without upgrading
  plugin add|ls|rm|enable|disable|secret|update|slot ...  manage runtime plugins
  plugin new|validate|list ...  author, validate and scaffold plugin dirs
  preset ls | show <id> | add <id> [key=value ...]  browse + install routine presets
  state ls | get <scope.key> | set <scope.key> <v> | incr <scope.key> [--by N]
        | cas <scope.key> <v> --expect <old> | history [<scope.key>]
                              shared state between routines and runs; incr and
                              cas are atomic. Inside a routine step the engine
                              bounds writes to that routine's state.writes.
  routines ls | activate <routine> --from <ts> [--until <ts>] [--runs n]
           | reset-budget <routine>   arm/re-arm a routine's activation window
                              and run budget at runtime (no Git edit)
  import-history --from <path> --chat <id> [--dry-run]  import prior-transport
                              chat history into this node (messages.db | jsonl)
  ctl status | doctor | routine … | runs … | task … | settings … | harness … |
      secret set … | restart | logs [n]
                              operate the RUNNING node from this shell: no agent
                              session, no LLM spend, --json on every command.
                              `agentos ctl --help` lists them all. Note the pair:
                              `agentos status` is the SERVICE view (is the unit
                              up), `agentos ctl status` is the NODE view
                              (version, uptime, harness, live runs).
  sessions <verb> …           durable agent sessions over this node's job API
                              (create|ls|status|attach|steer|stop|resume|budget;
                              `session` is the singular alias). Receipts, event
                              cursors and exit codes: `agentos sessions --help`
  mcp [--profile read|write] [--label <name>] [--print-surface]
                              serve THIS node to an external agent as an MCP
                              server over stdio (mount it elsewhere as
                              {"command":"agentos","args":["mcp"]}). Read-only
                              unless the node arms AGENTOS_MCP_EXTERNAL_PROFILE
  status | logs [n] | version
EOF
}

case "${1:-}" in
  install)    shift; exec bash <(curl -fsSL "https://raw.githubusercontent.com/${DIST_REPO}/main/install.sh") "$@" ;;
  upgrade)    shift; cmd_upgrade "$@" ;;
  autoupdate) shift; cmd_autoupdate "$@" ;;
  manual-upgrade) shift; cmd_manual_upgrade "$@" ;;
  rollback)   cmd_rollback ;;
  plugin)     shift; cmd_plugin "$@" ;;
  preset)     shift; cmd_preset "$@" ;;
  routines)   shift; cmd_routines "$@" ;;
  state)      shift; cmd_state "$@" ;;
  import-history) shift; cmd_import_history "$@" ;;
  ctl)        shift; cmd_ctl "$@" ;;
  sessions|session) shift; cmd_sessions "$@" ;;
  mcp)        shift; cmd_mcp "$@" ;;
  status)   cmd_status ;;
  logs)     shift || true; cmd_logs "${1:-200}" ;;
  version)  cmd_version ;;
  backup)   cmd_backup ;;
  *)        usage; exit 1 ;;
esac
