#!/usr/bin/env bash
# agentos — install, upgrade and operate an AgentOS Core node.
# Modes: docker (compose profile) | systemd (bare-metal, no Docker).
#
#   agentos install [installer flags]   fresh install (delegates to install.sh)
#   agentos upgrade [--to <tag>] [--force]  upgrade to the stable channel (or a pinned
#                                       tag); waits for a quiet moment unless --force
#   agentos rollback                    undo the last upgrade (code + database)
#   agentos backup                      take a manual backup without upgrading
#   agentos status | logs [n] | version
#
# Docker-mode operations shell out to `docker compose` exactly like
# install.sh does. Systemd-mode (bare-metal, no Docker) operates on the
# versions/<tag> + current-symlink layout that install.sh lays down under
# AGENTOS_HOME instead — see the systemd_* functions below.
set -euo pipefail

AGENTOS_HOME="${AGENTOS_DIR:-/opt/agentos}"
# Which install this invocation operates on. install.sh writes a tiny wrapper
# per named instance (--user) that pins these three; the default node needs no
# wrapper because these defaults ARE its layout.
AGENTOS_SERVICE="${AGENTOS_SERVICE:-agentos}"
AGENTOS_ACCOUNT="${AGENTOS_USER:-agentos}"
DIST_REPO="try-agent-os/agentos"
# shellcheck disable=SC2034  # kept for parity with install.sh/resolve-image.sh
# and reserved for later use (systemd mode, and a future manifest-trust check
# on the docker branches); stable.json's "image" field is already a
# fully-qualified ref, so nothing here consumes IMAGE_REPO yet.
IMAGE_REPO="${AGENTOS_IMAGE_REPO:-ghcr.io/try-agent-os/agentos-core}"
CHANNEL_URL="https://github.com/${DIST_REPO}/releases/latest/download/stable.json"
COMPOSE_FILE="docker-compose.node.yml"
BACKUP_DIR="$AGENTOS_HOME/backups"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
step() { echo -e "\n${CYAN}${BOLD}▸${NC} ${BOLD}$*${NC}"; }
info() { echo -e "  ${DIM}$*${NC}"; }
ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}!${NC} $*"; }
die()  { echo "agentos: $*" >&2; exit 1; }

detect_mode() {
  if [ -L "$AGENTOS_HOME/current" ]; then echo systemd
  elif [ -f "$AGENTOS_HOME/$COMPOSE_FILE" ]; then echo docker
  else echo none; fi
}

fetch_manifest() { # → stable.json on stdout
  curl -fsSL --max-time 30 "$CHANNEL_URL" || die "cannot fetch channel manifest: $CHANNEL_URL"
}

wait_healthz() {
  for _ in $(seq 1 45); do
    curl -fsS --max-time 3 "http://127.0.0.1:${AGENTOS_PORT:-8787}/healthz" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

# Mirrors scripts/agentos-upgrade.sh's uses_managed_postgres(): DATABASE_URL in
# .env means the node runs against managed PostgreSQL, not the local SQLite
# fallback — the /data volume this file otherwise backs up is not the source
# of truth, and its backups are external to this CLI entirely.
uses_managed_postgres() {
  grep -qE '^DATABASE_URL=.+' "$AGENTOS_HOME/.env" 2>/dev/null
}

# Mirrors agentos-upgrade.sh's managed-mode warning (lines 285-298): the boot
# guard (apps/api/src/core/db/schema-guard.ts) refuses to start an image older
# than the schema on disk, so blindly flipping AGENTOS_IMAGE back after a failed
# managed-PostgreSQL upgrade would trade a broken node for one that cannot boot
# at all. Say so and point at the real fix instead of pretending it is safe.
docker_managed_postgres_warning() { # docker_managed_postgres_warning [prev-image]
  local prev="${1:-}"
  warn "DATABASE_URL is set: there is no local backup to fall back to (managed"
  warn "PostgreSQL backups are external), and the schema may already have migrated"
  warn "past what an older image understands. A code-only rollback would hit the"
  warn "boot guard (database ahead of image) and fail to start."
  warn "Roll back the DATABASE from your managed-PostgreSQL provider's backup to a"
  warn "point before this upgrade${prev:+, then bring back $prev}."
  warn "To force an old image onto the migrated schema anyway (accepting the risk),"
  warn "set AGENTOS_SCHEMA_COMPAT_OVERRIDE=1 in .env before starting it."
}

# Pre-flight restore point + LOUD no-rollback notice for managed-PostgreSQL
# nodes, printed at UPGRADE TIME (both modes call this before flipping current).
#
# On a managed-PG node the local SQLite backup is a no-op and BOTH rollback
# paths — `agentos rollback` and the health-gated auto-rollback inside
# `agentos upgrade` — are refused: migrations are forward-only and the schema
# boot-guard (apps/api/src/core/db/schema-guard.ts) will not start old code
# against a database a newer release already migrated. The only real recovery
# is EXTERNAL: restore the managed DB to a point BEFORE this upgrade from the
# provider's PITR, then re-pin the previous version.
#
# DECISION (do we snapshot the DB before flipping?): we deliberately do NOT call
# a provider snapshot API from the node. The node holds no provider credentials,
# providers differ (Neon / RDS / Fly PG), and Neon-style PITR is CONTINUOUS — an
# explicit snapshot is redundant inside the retention window. What a failed
# upgrade actually needs is a DEFINED restore target, so this records the exact
# pre-flip UTC timestamp + the previous version to
# $BACKUP_DIR/managed-restore-point and prints them loudly. That timestamp is
# the point to rewind PITR to. Full procedure: docs/runbooks/managed-pg-recovery.md.
managed_pg_restore_point() { # managed_pg_restore_point <prev> <target>
  uses_managed_postgres || return 0
  local prev="${1:-unknown}" target="${2:-unknown}" now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$BACKUP_DIR"
  {
    echo "restore_point_utc=$now"
    echo "previous_version=$prev"
    echo "target_version=$target"
  } > "$BACKUP_DIR/managed-restore-point"
  echo
  echo -e "${RED}${BOLD}  ┌─ MANAGED POSTGRESQL — NO AUTOMATIC ROLLBACK ────────────────────${NC}"
  echo -e "${RED}${BOLD}  │${NC} If this upgrade goes bad, ${BOLD}\`agentos rollback\` will NOT save you${NC}:"
  echo -e "${RED}${BOLD}  │${NC} the schema migrates forward-only and the boot guard refuses old"
  echo -e "${RED}${BOLD}  │${NC} code against it. Recovery is EXTERNAL and manual:"
  echo -e "${RED}${BOLD}  │${NC}   1. restore the managed DB to a point BEFORE ${BOLD}${now}${NC}"
  echo -e "${RED}${BOLD}  │${NC}      from your provider's PITR / backup, then"
  echo -e "${RED}${BOLD}  │${NC}   2. re-pin the previous version (${BOLD}${prev}${NC})."
  echo -e "${RED}${BOLD}  │${NC} Restore point saved: ${DIM}$BACKUP_DIR/managed-restore-point${NC}"
  echo -e "${RED}${BOLD}  │${NC} Runbook: ${DIM}docs/runbooks/managed-pg-recovery.md${NC}"
  echo -e "${RED}${BOLD}  └─────────────────────────────────────────────────────────────────${NC}"
  echo
}

# Idempotent AGENTOS_IMAGE= rewrite in .env; drops the sed -i.bak leftover on
# success so a repeated upgrade/rollback doesn't litter the install dir.
docker_set_image() {
  sed -i.bak "s|^AGENTOS_IMAGE=.*|AGENTOS_IMAGE=${1}|" "$AGENTOS_HOME/.env"
  rm -f "$AGENTOS_HOME/.env.bak"
}

# ─── what may be believed out of .env ───────────────────────────────────────
#
# .env is the node's configuration AND a file the UNPRIVILEGED core owns and can
# rewrite: install.sh chowns the whole install root to the service account, the
# core runs with no systemd sandbox at all, and agent sessions run as
# that account with a shell. This CLI reads that file as ROOT — inside an upgrade
# it mkdir/chmod 0750/chowns the two directories it names, and it copies two of
# its values into the root poller's unit (which has no EnvironmentFile= precisely
# so that the core cannot hand root an environment; see
# scripts/release/agentos-autoupdate.service). So nothing leaves this file
# unchecked. install.sh has the same three rules; the two are separate by
# necessity (this CLI ships inside the image, install.sh arrives by curl) and
# must be kept in step by hand, exactly like create_signal_dirs/ensure_signal_dirs.
dotenv_val() { # dotenv_val <key> — the last assignment of <key> in .env, or empty
  sed -n "s/^$1=//p" "$AGENTOS_HOME/.env" 2>/dev/null | tail -1 || true
}

# One key into .env, atomically, without disturbing the file's identity.
# Every step is checked and the ORIGINAL is only replaced by a complete temp
# file, because the alternatives both lose data on a full disk: a `>` redirect
# onto .env truncates at open, so an ENOSPC mid-write leaves the node's .env
# partial — bot token and database credentials gone — and an unchecked write
# leaves a caller acting on the strength of a rewrite that never happened.
#
# The temp file lives in the SAME directory as .env (never /tmp: that is a
# cross-filesystem rename, and a world-listable place to stage a file that holds
# secrets), and the original's mode and owner are copied onto it before the
# rename: .env is 0600 owned by the service account while this CLI runs as root,
# and a bare `mv` would hand the node its own config file back as root-owned and
# unreadable. --reference is GNU coreutils, which is what a node runs; the
# fallback keeps the mode right anywhere else.
#
# Never CREATES .env: a node without one is a node this CLI has no business
# inventing an install root config for, and a root-owned 0600 file appearing
# under an install root the service account owns would be its own small outage.
write_env_key() { # write_env_key <key> <value> — 0 only if .env now holds it
  local key="$1" value="$2" env_file="$AGENTOS_HOME/.env" tmp rc
  [ -f "$env_file" ] || return 1
  tmp="$(mktemp "${env_file}.XXXXXX")" || return 1
  if grep -v "^${key}=" "$env_file" > "$tmp"; then rc=0; else rc=$?; fi
  # grep exits 1 when it merely selected nothing (an .env holding only the key
  # being replaced, or an empty one) — that is not a failure. 2 is.
  if [ "$rc" -gt 1 ] || ! printf '%s=%s\n' "$key" "$value" >> "$tmp"; then
    rm -f "$tmp"; return 1
  fi
  chmod --reference="$env_file" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  chown --reference="$env_file" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$env_file" || { rm -f "$tmp"; return 1; }
  return 0
}

# The five words the policy may be — the same enum the core's env schema accepts
# (apps/api/src/app/config/env.ts), so a value refused here would have refused to
# let the node boot anyway. It matters beyond tidiness because this value is
# written into the poller's unit as `Environment=AGENTOS_AUTOUPDATE_POLICY=<it>`,
# and systemd reads ONE such line as SEVERAL assignments when the value contains
# whitespace: `all AGENTOS_AUTOUPDATE_NOTIFY_CMD=/bin/sh -c …` would hand the root
# oneshot a command to run.
valid_policy() { case "${1:-}" in off|security|patch|minor|all) return 0 ;; *) return 1 ;; esac; }

# A path this CLI is willing to create, chmod, chown as root and copy into a unit.
# Absolute, at least two components, no traversal, no character that would split
# or be expanded inside a systemd Environment= line — and ending in the component
# the product actually uses. That last rule is the one that does the work, and it
# is a whitelist rather than a blacklist of dangerous paths: nothing on a Linux
# host is called `signals` or `outbox`, so AGENTOS_SIGNAL_INBOX=/etc/systemd/system
# (which would hand the service account every unit root runs) and =/ (which would
# chmod 0750 the host's root directory) are both refused without this function
# having to enumerate them.
# A validated PATH is still not a safe TARGET, which is what this second guard
# is for. $AGENTOS_HOME belongs to the unprivileged core (install.sh chowns the
# tree to the service account on every re-run, and the core runs unconfined), so
# it can replace a name under that root with a symlink
# — and root's mkdir/chmod/chown all FOLLOW symlinks. Aimed at
# /etc/systemd/system, the chown hands the service account every unit root runs.
# signal_path_ok above cannot catch it: the DEFAULT path is the vector, and the
# default is legitimate. The attack is on what the name points AT.
#
# File scope, not nested in its caller, and the same function under the same
# name in install.sh — which has three call sites of its own. Hand-copied parity
# between these two files has already produced two wrong comments and one
# unreachable helper on this branch alone.
#
# Returns 0 when <path> is free (the caller's mkdir is what creates it) or is a
# real directory. Never for a symlink, and never for anything else that exists.
plain_dir_ok() { # plain_dir_ok <path> <label> -> 0 when it is safe to create/chmod/chown
  # -L FIRST. A dangling symlink is -L true, -e false and -d false, so every
  # other test reads it as "not there yet" and goes on to mkdir — which fails
  # EEXIST over a link, and reported THAT as "could not create the inbox": a
  # disk-full story told about an attack, in the one line an operator reading an
  # upgrade log has to go on.
  if [ -L "$1" ]; then
    warn "refusing to touch the $2 ($1): it is a symlink, not a directory — nothing was created, chmod'ed or chowned. Remove it and re-run; the node keeps updating on the six-hourly timer meanwhile"
    return 1
  fi
  [ ! -e "$1" ] && return 0        # free: the caller's mkdir is what creates it
  [ -d "$1" ] && return 0
  warn "refusing to touch the $2 ($1): it exists but is not a directory — nothing was created, chmod'ed or chowned"
  return 1
}

signal_path_ok() { # signal_path_ok <path> <required-last-component>
  local p="${1:-}"
  case "$p" in
    /*/*) ;;                        # absolute AND at least two components
    *) return 1 ;;
  esac
  case "$p" in
    */../*|*/..)   return 1 ;;
    *[[:space:]]*) return 1 ;;
    *\"*|*\'*|*\$*|*%*|*\\*) return 1 ;;
  esac
  [ "${p##*/}" = "$2" ]
}

# Both signal paths, as this node should use them: from .env when .env states
# something usable, from the values install.sh would have written otherwise.
# Sets SIGNAL_INBOX / SIGNAL_OUTBOX. <mode> picks which key pair is preferred —
# docker mode's *_HOST keys are the ones compose interpolates for the mount
# sources, so what gets created there is exactly what will be mounted — but
# either pair holds the same HOST paths, so both are consulted.
#
# A refused value falls back rather than aborting: the .path unit watches
# <install root>/signals whatever .env says, so the default is the coherent
# answer, and an upgrade that is already live and healthy must not be undone
# over a bad line in a config file. It is never silent, though — the whole point
# is that someone learns .env is lying.
resolve_signal_paths() { # resolve_signal_paths <docker|systemd>
  local first="AGENTOS_SIGNAL_INBOX" second="AGENTOS_SIGNAL_INBOX_HOST"
  [ "$1" = docker ] && { first="AGENTOS_SIGNAL_INBOX_HOST"; second="AGENTOS_SIGNAL_INBOX"; }
  SIGNAL_INBOX="$(dotenv_val "$first")"
  [ -n "$SIGNAL_INBOX" ] || SIGNAL_INBOX="$(dotenv_val "$second")"
  if [ -n "$SIGNAL_INBOX" ] && ! signal_path_ok "$SIGNAL_INBOX" signals; then
    warn "refusing the update-signal inbox '${SIGNAL_INBOX}' from .env — it is not an absolute path ending in /signals; using ${AGENTOS_HOME}/signals instead"
    SIGNAL_INBOX=""
  fi
  [ -n "$SIGNAL_INBOX" ] || SIGNAL_INBOX="$AGENTOS_HOME/signals"

  first="AGENTOS_SIGNAL_OUTBOX"; second="AGENTOS_SIGNAL_OUTBOX_HOST"
  [ "$1" = docker ] && { first="AGENTOS_SIGNAL_OUTBOX_HOST"; second="AGENTOS_SIGNAL_OUTBOX"; }
  SIGNAL_OUTBOX="$(dotenv_val "$first")"
  [ -n "$SIGNAL_OUTBOX" ] || SIGNAL_OUTBOX="$(dotenv_val "$second")"
  if [ -n "$SIGNAL_OUTBOX" ] && ! signal_path_ok "$SIGNAL_OUTBOX" outbox; then
    warn "refusing the update-signal outbox '${SIGNAL_OUTBOX}' from .env — it is not an absolute path ending in /outbox; using /var/lib/${AGENTOS_SERVICE}/outbox instead"
    SIGNAL_OUTBOX=""
  fi
  # Keyed off the UNIT name, never the install root's basename: `--user hub`
  # gives /opt/hub but the unit is agentos-hub.
  [ -n "$SIGNAL_OUTBOX" ] || SIGNAL_OUTBOX="/var/lib/${AGENTOS_SERVICE}/outbox"
  # Explicit, so no future edit can leave a false test as this function's status
  # and have `set -e` kill an upgrade at the call site.
  return 0
}
SIGNAL_INBOX=""; SIGNAL_OUTBOX=""

# ─── the quiet-moment guard, shared with the unattended updater ──────────────
#
# ClickUp 86cbc3grw (continuation of 86cbc1pae). A long stop is a DRAIN, not a
# hang: on SIGTERM the core waits out agent turns already in flight. It only gets
# long when a restart is fired INTO a live turn. scripts/agentos-autoupdate.sh has
# refused to do that for a while (verdict=deferred reason=activity); the hands-on
# paths — this CLI's `upgrade`, and `agentos plugin` — did it blind. Same question,
# one implementation: scripts/lib/node-activity.sh, sourced by all three.
#
# Two escapes, and only two, matching the updater's: an explicit `--force`, and the
# wait CEILING (AGENTOS_RESTART_GUARD_TIMEOUT, default 900s) after which the restart
# proceeds anyway. The core writes the busy signal, so it must be able to DELAY an
# operator and never to block one.
_CLI_HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -r "$_CLI_HERE/lib/node-activity.sh" ]; then
  # shellcheck source=lib/node-activity.sh
  . "$_CLI_HERE/lib/node-activity.sh"
  AGENTOS_ACTIVITY_GUARD=1
else
  AGENTOS_ACTIVITY_GUARD=0
fi

# await_quiet_moment <what> — block until no owner turn is in flight, then return.
# NEVER fails the caller: worst case it prints why it could not wait and returns 0,
# because a guard that can cancel an upgrade is a guard that can strand a node.
await_quiet_moment() { # await_quiet_moment <label>
  local label="${1:-restart}"
  [ "${FORCE_RESTART:-0}" = 1 ] && { info "restart-guard: verdict=proceed reason=forced (--force) — not waiting for a quiet moment"; return 0; }
  if [ "$AGENTOS_ACTIVITY_GUARD" != 1 ]; then
    warn "restart-guard: verdict=proceed reason=guard-lib-missing — cannot see owner activity from $_CLI_HERE; ${label} proceeds blind"
    return 0
  fi
  # The host-side inbox is where the core writes signals/activity; resolve it the
  # same way the upgrade paths resolve every other signal path, never raw.
  [ -n "${SIGNAL_INBOX:-}" ] || resolve_signal_paths "$(detect_mode)"
  node_activity_use_marker "$SIGNAL_INBOX/activity"
  node_wait_for_quiet "${AGENTOS_RESTART_GUARD_TIMEOUT:-900}" || true
  return 0
}

# ─── both modes: reconcile the systemd unit set with the release ────────────
#
# Units are the one part of an install that no upgrade path has ever touched:
# systemd_upgrade only flips the `current` symlink and never enters
# /etc/systemd/system, and docker_refresh_profiles stopped at the CLI, the
# poller and the run config. That was harmless while the unit set was static.
# It stopped being harmless the moment a release started shipping a NEW unit
# (agentos-autoupdate.path) that a node MUST have for the in-core detector's
# pokes to be heard: without this, every existing node upgrades to a core that
# writes pokes nobody listens to, keeps updating on the six-hourly backstop,
# and nothing anywhere says the fast path never armed.
#
# Both modes share it because both get their units the same way: the templates
# ride the profiles/ layer (docker/Dockerfile.node copies all three into
# /app/profiles; a release tarball carries them at current/profiles/), and a
# docker node's auto-update poller is a HOST systemd unit exactly like a
# bare-metal one.
#
# Only what changed is rewritten, so an upgrade that finds the unit set already
# current does not reload systemd or restart anything at all.
# Re-assert the ACLs of any declared external secret readers (see install.sh's
# --secret-reader). The declaration lives in a root-owned file OUTSIDE the
# install root; an upgrade re-materialises the version tree and can reset perms,
# so every `agentos upgrade` re-applies these grants — the durable half of the
# guarantee that a host-side reader (a freshness monitor, a backup job) keeps
# reading $AGENTOS_HOME/secrets across node updates without a manual setfacl.
reconcile_secret_reader_acls() {
  local f="${AGENTOS_SECRET_READERS_FILE:-/var/lib/${AGENTOS_SERVICE}/secret-readers}"
  local readers secrets_dir="$AGENTOS_HOME/secrets" u
  [ -r "$f" ] || return 0
  readers="$(sed 's/[[:space:]]//g; /^$/d' "$f" 2>/dev/null || true)"
  [ -n "$readers" ] || return 0
  command -v setfacl >/dev/null 2>&1 || { warn "setfacl not found — cannot re-apply secret-reader ACLs (install the 'acl' package)"; return 0; }
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    case "$u" in *[!a-z0-9_-]*|[!a-z_]*) warn "secret-reader '${u}': invalid account name — skipping"; continue ;; esac
    if [ "$u" = "$AGENTOS_ACCOUNT" ]; then continue; fi
    id "$u" >/dev/null 2>&1 || { warn "secret-reader '${u}': no such account — skipping"; continue; }
    setfacl -m "u:${u}:--x" "$AGENTOS_HOME" || { warn "secret-reader '${u}': traverse grant on ${AGENTOS_HOME} failed"; continue; }
    if [ -d "$secrets_dir" ]; then
      setfacl -R -m "u:${u}:rX" "$secrets_dir" || warn "secret-reader '${u}': read grant on ${secrets_dir} failed"
      setfacl -R -d -m "u:${u}:rX" "$secrets_dir" 2>/dev/null || true
    fi
    ok "secret reader ${u}: rX on ${secrets_dir} (+ traverse on ${AGENTOS_HOME})"
  done <<< "$readers"
}

reconcile_units() { # reconcile_units <profiles-dir>
  local pdir="$1" au="${AGENTOS_SERVICE}-autoupdate" changed=0 main_unit_changed=0
  # Overridable so the suite can assert the rendered output without root.
  local units_dir="${AGENTOS_UNITS_DIR:-/etc/systemd/system}"
  command -v systemctl >/dev/null 2>&1 || return 0
  [ -d "$pdir" ] || return 0
  [ -d "$units_dir" ] || return 0

  # No User=/Group= rewriting here: the oneshot runs as root by design and the
  # .timer/.path carry no User= at all. Only the install-root placeholder, the
  # CLI entry point and the unit reference need substitution — and the two are
  # NOT interchangeable: `--user foo` gives install root /opt/foo but unit name
  # agentos-foo, so the .path must watch $AGENTOS_HOME while being called
  # ${au}.path. Same three substitutions install.sh's install_autoupdate_timer
  # makes, against the same templates.
  render_unit() { # render_unit <src> <dst> [lines appended to the render]
    # A node upgrading from a release that predates a template simply has no
    # source file — never an error, and never a unit invented out of nothing.
    [ -f "$1" ] || return 0
    local rendered
    rendered="$(sed -e "s|/opt/agentos|${AGENTOS_HOME}|g" \
                    -e "s|^ExecStart=/usr/local/bin/agentos |ExecStart=/usr/local/bin/${AGENTOS_SERVICE} |" \
                    -e "s|^Unit=agentos-autoupdate.service$|Unit=${au}.service|" "$1")"
    # An `if`, never `[ -n … ] && rendered=…`: as a bare statement a false test
    # is the command's exit status, and `set -e` would kill the upgrade here.
    if [ -n "${3:-}" ]; then
      rendered="${rendered}
$3"
    fi
    if [ ! -f "$2" ] || [ "$rendered" != "$(cat "$2" 2>/dev/null)" ]; then
      if printf '%s\n' "$rendered" > "$2"; then
        changed=1
      else
        warn "could not write $2 — the old unit stays in place"
      fi
    fi
  }

  # The atomic single-key rewrite lives at the top of this file now
  # (write_env_key), because ensure_signal_dirs needs the identical guarantees
  # — .env keeps its owner and 0600 mode, and a failed write leaves the old file
  # whole rather than a truncated one missing the bot token. This name stays as
  # the caller's vocabulary: the migration below decides whether to delete the
  # operator's only record of their policy on this return value.
  write_env_policy() { # write_env_policy <value> — 0 only if .env now holds it
    write_env_key AGENTOS_AUTOUPDATE_POLICY "$1"
  }

  render_unit "$pdir/agentos-autoupdate.timer"   "$units_dir/${au}.timer"
  render_unit "$pdir/agentos-autoupdate.path"    "$units_dir/${au}.path"

  # The oneshot is rendered further down, after the drop-in migration: it now
  # carries the policy, and the migration is what settles the policy.

  # The drop-in migration must happen HERE, not only in install.sh: existing
  # nodes get their units through this path and never re-run the installer. A
  # unit that starts reading EnvironmentFile= while a stale policy.conf is still
  # on disk leaves the winner ambiguous — and the operator who narrowed the
  # policy silently back on `all` is the worst possible outcome of this feature.
  local dropin_dir="$units_dir/${au}.service.d" conf="$units_dir/${au}.service.d/policy.conf"
  if [ -f "$conf" ]; then
    # Read the value the way SYSTEMD would, not the way install.sh happened to
    # write it — docs/self-host.md tells operators to set the policy "in the
    # drop-in", so this file is hand-edited in the field. Same extraction as
    # install.sh's migrate_policy_dropin, and for the same reason: the strict
    # `^Environment=K=` pattern matched only the bare form, so a quoted, indented
    # or CRLF spelling came back empty, nothing reached .env, and the `rm -f`
    # below then deleted the operator's only record of their choice. Take
    # everything after `Environment=`, drop the quotes whichever spelling used
    # them, split on whitespace (which puts each assignment — and a trailing CR —
    # on its own line), and only then match the key. tail -1 keeps last-wins.
    local migrated
    migrated="$(sed -n 's/^[[:space:]]*Environment[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null \
      | sed "s/[\"']//g" \
      | tr ' \t\r' '\n\n\n' \
      | sed -n 's/^AGENTOS_AUTOUPDATE_POLICY=//p' | tail -1 || true)"
    # The drop-in is the operator's ONLY record of the value until it is safely
    # in .env, so it is deleted only once the rewrite has actually landed. An
    # unchecked write here would be the same silent return to `all` the tolerant
    # parsing above exists to prevent, reached by another route — and the
    # realistic trigger is not permissions on a root-run CLI but ENOSPC or a
    # read-only remount, seconds after a tarball unpack or a `docker pull`.
    local keep_dropin=0
    if [ -n "$migrated" ]; then
      if [ ! -f "$AGENTOS_HOME/.env" ]; then
        warn "policy '$migrated' is still in ${conf} — no $AGENTOS_HOME/.env to move it into"
        keep_dropin=1
      elif write_env_policy "$migrated"; then
        ok "migrated auto-update policy '$migrated' into .env"
      else
        warn "could not write $AGENTOS_HOME/.env — policy '$migrated' left in $conf"
        keep_dropin=1
      fi
    fi
    if [ "$keep_dropin" = 0 ]; then
      rm -f "$conf"
      # Only when it is now empty — an operator may have their own drop-ins here.
      rmdir "$dropin_dir" 2>/dev/null || true
      changed=1
    fi
  fi

  # The oneshot, and only now: it CARRIES the policy, so rendering it before the
  # migration above would arm the poller with `all` while .env said `minor` —
  # until some later upgrade happened to re-render it. That is the very
  # two-source ambiguity the migration exists to remove, one layer down.
  #
  # It carries the policy at all because the unit has no EnvironmentFile=: .env
  # belongs to the unprivileged core, and a root unit that read it would let the
  # core name AGENTOS_AUTOUPDATE_NOTIFY_CMD / _APPLY_CMD (both `bash -c`'d as
  # root) and AGENTOS_UPDATES_URL. So root reads .env, validates, and writes the
  # two values the poller and the in-core detector must agree on into the unit
  # itself. Same single source, opposite direction of trust.
  local policy svc_env
  policy="$(dotenv_val AGENTOS_AUTOUPDATE_POLICY)"
  if [ -n "$policy" ] && ! valid_policy "$policy"; then
    warn "ignoring AGENTOS_AUTOUPDATE_POLICY='${policy}' in .env — not one of off|security|patch|minor|all; arming the poller with 'all'"
    policy=""
  fi
  [ -n "$policy" ] || policy=all
  resolve_signal_paths systemd     # either key pair; both hold the HOST paths
  svc_env="$(printf 'Environment=AGENTOS_AUTOUPDATE_POLICY=%s\nEnvironment=AGENTOS_SIGNAL_INBOX=%s\nEnvironment=AGENTOS_SIGNAL_OUTBOX=%s' \
    "$policy" "$SIGNAL_INBOX" "$SIGNAL_OUTBOX")"
  # The activity-gate thresholds the poller shares with the in-core detector
  # (scripts/agentos-autoupdate.sh). Both halves DEFAULT identically, so these are
  # carried only when an operator overrode them in .env — otherwise the poller
  # keeps the shared default and the two paths still agree. A non-integer value is
  # dropped rather than passed through, so a fat-fingered .env cannot arm root
  # with a word the poller would then sanitise to a different number than the core.
  local _gk _gv
  for _gk in AGENTOS_UPDATE_MAX_DEFERRAL AGENTOS_UPDATE_RESTART_INTERVAL; do
    _gv="$(dotenv_val "$_gk")"
    case "$_gv" in
      ''|*[!0-9]*) : ;;
      *) svc_env="$(printf '%s\nEnvironment=%s=%s' "$svc_env" "$_gk" "$_gv")" ;;
    esac
  done
  render_unit "$pdir/agentos-autoupdate.service" "$units_dir/${au}.service" "$svc_env"

  # ─── the MAIN service unit ──────────────────────────────────────────────
  #
  # Everything above reconciles only the auto-update units. The main service
  # unit (${AGENTOS_SERVICE}.service) was the one file NO upgrade path ever
  # rewrote: install.sh writes it once, systemd_upgrade only flips `current`,
  # and reconcile_units stopped at the poller. So a release that changed the
  # unit template — e.g. TimeoutStopSec=120→660 in v2.47.0, which the node's
  # shutdown drain reads as AGENTOS_STOP_TIMEOUT_SEC — silently never reached an
  # already-installed node. The drain's LEGACY_UNIT_DRAIN_TIMEOUT_MS fallback
  # (apps/api/src/core/session-durability.ts) MASKED the gap rather than closing
  # it: correct behaviour on a stale unit, but the node keeps running the old
  # unit and nothing says so. Re-render it here from the SAME template and the
  # SAME substitutions install.sh's install_systemd() uses.
  #
  # ONLY when the node already has one. reconcile keeps an existing unit in step
  # with the release; it never INVENTS the main unit on a host install.sh did
  # not write it — a docker node has no main systemd unit at all (its service is
  # the compose container, only the auto-update poller is a host unit), so the
  # `-f "$main_unit"` guard makes this correctly skip there.
  #
  # Local drop-ins live in ${AGENTOS_SERVICE}.service.d/*.conf — a separate tree
  # this write never touches — so an operator's override (e.g. Symoditi's manual
  # 21-stop-timeout.conf) survives the migration untouched.
  local main_unit="$units_dir/${AGENTOS_SERVICE}.service"
  if [ -f "$main_unit" ] && [ -f "$pdir/agentos.service" ]; then
    # The template the node is being migrated ONTO appends stdout+stderr to
    # <root>/logs/node.log. install.sh creates that directory; no upgrade path
    # did, so a node installed before the log file existed got the new unit
    # written over a root with no logs/ — and systemd cannot open an append
    # target whose directory is missing. It does not degrade: the unit fails
    # 209/STDOUT before ExecStart, Restart=always retries, and the node sits in
    # a restart loop until a human creates one directory. That is exactly what
    # took the Symoditi node down on 2026-08-19 (restart counter 54, ~6 min of
    # downtime), and it would have hit every pre-log-file install on ITS next
    # upgrade. Create the directory BEFORE writing the unit, never after: the
    # window between the two is precisely the failure.
    if plain_dir_ok "$AGENTOS_HOME/logs" "log directory"; then
      if [ ! -d "$AGENTOS_HOME/logs" ]; then
        if mkdir -p "$AGENTOS_HOME/logs" 2>/dev/null; then
          chmod 0750 "$AGENTOS_HOME/logs" 2>/dev/null || true
          chown "$AGENTOS_ACCOUNT:$AGENTOS_ACCOUNT" "$AGENTOS_HOME/logs" 2>/dev/null \
            || warn "created $AGENTOS_HOME/logs but could not chown it to $AGENTOS_ACCOUNT — the node may not be able to write its log"
          ok "created the node's log directory ($AGENTOS_HOME/logs), which the release unit template writes into"
        else
          warn "could not create $AGENTOS_HOME/logs — leaving the old main service unit in place rather than pointing a new one at a missing log directory"
          pdir_logs_missing=1
        fi
      fi
    else
      pdir_logs_missing=1
    fi
  fi
  if [ -f "$main_unit" ] && [ -f "$pdir/agentos.service" ] && [ "${pdir_logs_missing:-0}" != 1 ]; then
    # The install-root placeholder everywhere, then User=/Group= on their own
    # anchored lines. NOT a global s|agentos|<user>|: the account name is a
    # substring of every install path, so only anchored ^User= / ^Group= are
    # safe to rewrite. Identical to install.sh's main-unit render.
    local main_rendered
    main_rendered="$(sed -e "s|/opt/agentos|${AGENTOS_HOME}|g" \
                         -e "s|^User=agentos$|User=${AGENTOS_ACCOUNT}|" \
                         -e "s|^Group=agentos$|Group=${AGENTOS_ACCOUNT}|" "$pdir/agentos.service")"
    if [ "$main_rendered" != "$(cat "$main_unit" 2>/dev/null)" ]; then
      if printf '%s\n' "$main_rendered" > "$main_unit"; then
        changed=1; main_unit_changed=1
        ok "migrated main service unit ${AGENTOS_SERVICE}.service to the release template (local drop-ins preserved)"
      else
        warn "could not write $main_unit — the old main service unit stays in place"
      fi
    fi
  fi

  # OUTSIDE the changed-gate on purpose, and this is the whole point of the
  # call: a poke storm trips StartLimitBurst=5 and leaves the oneshot failed,
  # and that oneshot is what BOTH the .path and the .timer fire — nothing
  # unattended runs again, so the node cannot upgrade itself out of it. The way
  # back is a human running `agentos upgrade`, and on a node whose units are
  # already current that run has nothing to change. Gated on `changed`, the
  # clearing would never fire in the one scenario it exists for. It is a no-op
  # on a healthy unit, so running it every time is free.
  #
  # `${au}.timer` belongs in this list too, not just `.path`/`.service`: when the
  # oneshot they both fire hits its StartLimitBurst, systemd fails the JOB that
  # activates it — and that failure propagates to whichever trigger unit issued
  # the job, timer included, not only the .path. Leaving it out of reset-failed
  # was itself a live bug (2026-08-30, task 86cbbrmbz): a hub upgrade to
  # v2.73.0 left both agentos-hub-autoupdate.timer AND .path `inactive (dead)`,
  # `Trigger: n/a`, with no error anywhere — a release then shipped at 20:09 and
  # the node sat on the old version past 21:00 because nothing was left to fire
  # the next check.
  if [ -f "$units_dir/${au}.service" ]; then
    systemctl reset-failed "${au}.timer" "${au}.path" "${au}.service" >/dev/null 2>&1 || true
  fi

  # BEFORE the re-arm below, not after: when `changed` is 1 the files on disk
  # just moved out from under systemd's cached unit definitions, and enabling
  # or starting a unit before a reload arms it against the STALE in-memory
  # copy. daemon-reload stays gated on `changed` — nothing to pick up otherwise.
  if [ "$changed" = 1 ]; then
    systemctl daemon-reload || warn "daemon-reload failed; units will apply on next boot"
    ok "reconciled auto-update units"
  fi

  # Re-arming is why the reset above exists at all, and it has the SAME
  # changed-gate bug reset-failed used to have: `reset-failed` only clears the
  # failure counter, it never restarts anything, so a `.path`/`.timer` a poke
  # storm knocked dead stays dead forever once gated behind `changed` — the
  # very upgrade whose burst caused the trip usually leaves the unit set
  # byte-identical (the trip is a runtime event, not a template edit), so
  # `changed` is 0 on exactly the run that most needs this. `enable --now` on
  # an already-active unit is a no-op, so running it unconditionally on every
  # reconcile is free and self-heals the fast path within the same invocation
  # that broke it, without waiting on a human or a second release.
  if [ -f "$units_dir/${au}.path" ]; then
    systemctl enable --now "${au}.path" >/dev/null 2>&1 || true
  fi
  if [ -f "$units_dir/${au}.timer" ]; then
    systemctl enable --now "${au}.timer" >/dev/null 2>&1 || true
  fi

  # The daemon-reload above re-reads the main unit, so systemd honours the new
  # TimeoutStopSec at the next stop. But start-time-only directives (User=,
  # ExecStart=, the sandboxing paths) apply only when the service (re)starts —
  # and reconcile deliberately does NOT restart the node here (in the upgrade
  # path it was just started; in the idempotent `already at $tag` path a restart
  # would be a surprise). Say so plainly rather than let a stale live process
  # imply the migration is already fully in effect.
  if [ "$main_unit_changed" = 1 ]; then
    ok "main service unit changed — restart '${AGENTOS_SERVICE}' to apply start-time directives"
  fi
  return 0
}

# ─── docker mode: refresh the operator tooling that ships in the image ───────
#
# The run profiles (compose file + Caddyfile + the `agentos` CLI itself + the
# auto-update poller) travel INSIDE the image under /app/profiles and are
# `docker cp`'d out to $AGENTOS_HOME by install.sh (install.sh §Run profile).
# docker_upgrade swaps the node's IMAGE but, before this, left those extracted
# files frozen at install time (issue #112): the on-PATH `agentos`,
# agentos-autoupdate.sh and compose file kept the shape they had the day the box
# was installed, so a materially changed CLI needed a full installer re-run to
# land. Bare-metal (systemd) mode has no such gap — its CLI is a symlink through
# current/profiles/agentos, so a version flip repoints it for free.
#
# So, after a HEALTHY docker upgrade, re-extract /app/profiles from the new image
# and reconcile the on-disk copies:
#   • The CLI + the auto-update poller are OUR operator tooling, not user config
#     — always track the image. The overwrite is a same-filesystem `mv` (atomic
#     rename): the running CLI keeps executing its already-open inode, so a CLI
#     refreshing ITSELF mid-run is safe.
#   • The compose file + Caddyfile are run config a self-hoster may have hand
#     edited. NEVER clobber a local edit silently: adopt the new image's copy
#     only when the on-disk file still byte-matches what the PREVIOUS image
#     shipped (i.e. untouched since the last extraction). If it diverged — a
#     local customization, or we cannot obtain the old copy to be sure — keep it
#     and warn, so a structural compose change surfaces without eating edits.
# A source checkout ($AGENTOS_HOME/.git) is left entirely alone, mirroring
# install.sh's guard: its files are the working tree, owned by git, not us.
# Best-effort throughout — a hiccup here never fails an upgrade that is already
# live and healthy.
docker_refresh_profiles() { # docker_refresh_profiles <new-image> [prev-image]
  local new_image="${1:?docker_refresh_profiles needs the new image}" prev_image="${2:-}"
  if [ -d "$AGENTOS_HOME/.git" ]; then
    info "source checkout — leaving the CLI, compose file and Caddyfile as the git tree has them"
    return 0
  fi
  local stage oldstage="" c f rel
  stage="$AGENTOS_HOME/.profiles-new.$$"
  rm -rf "$stage"; mkdir -p "$stage"
  if ! c="$(docker create "$new_image" 2>/dev/null)" || [ -z "$c" ]; then
    warn "could not stage the new image to refresh the CLI — leaving on-disk tooling unchanged"
    rm -rf "$stage"; return 0
  fi
  if ! docker cp "${c}:/app/profiles/." "$stage/" >/dev/null 2>&1; then
    warn "new image has no /app/profiles — leaving on-disk tooling unchanged"
    docker rm "$c" >/dev/null 2>&1 || true; rm -rf "$stage"; return 0
  fi
  docker rm "$c" >/dev/null 2>&1 || true

  # 1. Self-updating operator tooling — always tracks the image, atomic rename.
  # lib/node-activity.sh is a RELATIVE path, not a bare name: the guard the two
  # scripts above source resolves as "<their own dir>/lib/node-activity.sh", so it
  # must land under $AGENTOS_HOME/lib/ — hence the mkdir. Leave it out and a node
  # refreshes a CLI that then cannot see owner activity at all.
  for f in agentos agentos-autoupdate.sh lib/node-activity.sh; do
    [ -f "$stage/$f" ] || continue
    if [ -f "$AGENTOS_HOME/$f" ] && cmp -s "$stage/$f" "$AGENTOS_HOME/$f"; then
      continue   # already current — no needless churn
    fi
    chmod +x "$stage/$f" 2>/dev/null || true
    mkdir -p "$(dirname "$AGENTOS_HOME/$f")"
    mv -f "$stage/$f" "$AGENTOS_HOME/$f"   # same-fs rename: atomic, safe self-overwrite
    ok "refreshed $f from the new image"
  done

  # 2. Run config — refresh only if untouched since the last extraction. Compare
  #    against what the PREVIOUS image shipped; if we cannot get it, stay safe
  #    and treat every difference as a local edit (warn, keep).
  if [ -n "$prev_image" ]; then
    local pc
    if pc="$(docker create "$prev_image" 2>/dev/null)" && [ -n "$pc" ]; then
      oldstage="$AGENTOS_HOME/.profiles-old.$$"
      rm -rf "$oldstage"; mkdir -p "$oldstage"
      docker cp "${pc}:/app/profiles/." "$oldstage/" >/dev/null 2>&1 || { rm -rf "$oldstage"; oldstage=""; }
      docker rm "$pc" >/dev/null 2>&1 || true
    fi
  fi
  for rel in "$COMPOSE_FILE" "docker/Caddyfile"; do
    local newf="$stage/$rel" curf="$AGENTOS_HOME/$rel" oldf="$oldstage/$rel"
    [ -f "$newf" ] || continue
    if [ ! -f "$curf" ]; then
      mkdir -p "$(dirname "$curf")"; cp "$newf" "$curf"; ok "installed $rel from the new image"; continue
    fi
    cmp -s "$newf" "$curf" && continue   # already identical
    if [ -n "$oldstage" ] && [ -f "$oldf" ] && cmp -s "$oldf" "$curf"; then
      cp "$newf" "$curf"; ok "refreshed $rel from the new image"
    else
      warn "kept your $rel — the new image ships a different one; diff and merge by hand to adopt it"
    fi
  done

  # 3. The host's systemd unit set, from the SAME staged profiles (the image
  #    ships the units next to the CLI), while the staging dir still exists.
  reconcile_units "$stage" || warn "unit reconciliation hit a snag"

  rm -rf "$stage" "$oldstage"
  return 0
}

# ─── both modes: the host side of the update signal channel ─────────────────
#
# install.sh creates these two directories on a fresh install. An UPGRADED node
# never re-runs the installer — and both upgrade paths otherwise leave it without
# them, in two different ways:
#
#   docker — docker_refresh_profiles above hands the node a compose file that
#     BIND-MOUNTS both. Left to docker, a missing mount source is invented
#     root-owned 0755 and the core (uid 1001) takes EACCES on every poke. That is
#     strictly worse than having no mounts at all: SignalChannel.available() sees
#     a directory and returns true, so the detector never emits its "signal
#     channel is unavailable" warning and never falls back. poke() throws out of
#     tick() once a minute instead, and the node stops updating IN SILENCE — the
#     announced-once degradation the spec requires, defeated.
#   systemd — the DEFAULT install mode. systemd_upgrade only flips the `current`
#     symlink, so the node arrives here with the .path unit freshly reconciled
#     onto it (reconcile_units above) and no inbox for it to watch. It degrades
#     correctly there — no directory, available() false, announce once, six-hourly
#     backstop — but the plan's whole point is ≤1 minute at idle, and without this
#     no existing node on the majority install mode would ever get it.
#
# The ownership split is install.sh's create_signal_dirs, restated rather than
# reused: that function lives in install.sh, which this CLI never sources — the
# CLI ships INSIDE the image at /app/profiles and reaches disk by `docker cp`,
# while install.sh arrives standalone through curl|bash, so there is no import
# path between them at any point in the lifecycle. Keep the two in step by hand.
#
#   inbox  — writable by whoever the core is, the only writer of pokes.
#   outbox — root's, group = the core, so it can READ result.json without being
#            able to create or swap one. 0750 both, never world-anything.
#
# WHO the core is, and it is the only thing that differs between the modes:
#   docker  — uid:gid 1001, the image's runtime user (docker/Dockerfile.node).
#             A NUMBER, not the name `agentos`: docker mode creates no unix
#             account at all, and a bind mount carries ids numerically.
#   systemd — the real service account, by name. It exists on any node this runs
#             on, but it is CHECKED first: `chown` against an unknown user exits
#             non-zero, and under `set -e` that would abort an upgrade mid-flight,
#             with the unit stopped and the symlink already flipped.
#
# Two deliberate departures from create_signal_dirs, both safety:
#   • the outbox's PARENT is not chmod'ed 0755. install.sh computes that path;
#     here it comes out of .env, so `chmod "$(dirname …)"` on an operator-chosen
#     value would reach somewhere this CLI has no business (/srv, /mnt, /).
#   • everything is best-effort, like the profile refresh: a hiccup must never
#     undo an upgrade that is already live and healthy. But a chown that CANNOT
#     be done is ANNOUNCED with the command that fixes it — a silent fallback
#     here would be the same class of failure this function exists to remove.
#
# Paths come from .env, which is where install.sh put them and where every other
# consumer reads them; in docker mode from the *_HOST pair, which is the one
# compose interpolates for the mount sources, so what is created is exactly what
# will be mounted. They come through resolve_signal_paths, never raw: this runs
# as root and chowns what it is told, and .env is a file the core can rewrite.
CORE_CONTAINER_UID=1001   # docker/Dockerfile.node: useradd -u 1001 -g nodejs
CORE_CONTAINER_GID=1001   # docker/Dockerfile.node: groupadd -g 1001 nodejs
ensure_signal_dirs() { # ensure_signal_dirs <docker|systemd>
  local mode="$1" inbox outbox inbox_owner outbox_group fix
  # Both paths through resolve_signal_paths, never read raw: this function then
  # runs mkdir / chmod 0750 / chown against them AS ROOT, so an unchecked
  # AGENTOS_SIGNAL_INBOX=/etc/systemd/system out of a file the core can rewrite
  # would hand the service account every unit root runs, and =/ would chmod the
  # host's root directory. The resolver also carries the `|| true` that keeps a
  # sed which cannot open .env from killing a mid-flight upgrade under
  # `set -o pipefail`.
  resolve_signal_paths "$mode"
  inbox="$SIGNAL_INBOX"; outbox="$SIGNAL_OUTBOX"
  if [ "$mode" = docker ]; then
    inbox_owner="${CORE_CONTAINER_UID}:${CORE_CONTAINER_GID}"
    outbox_group="${CORE_CONTAINER_GID}"
  else
    inbox_owner="${AGENTOS_ACCOUNT}:${AGENTOS_ACCOUNT}"
    outbox_group="${AGENTOS_ACCOUNT}"
    if ! id "$AGENTOS_ACCOUNT" >/dev/null 2>&1; then
      # Not fatal, and not silent: the directories are still worth creating (the
      # .path unit needs the inbox to exist at all), but say which one is unowned.
      warn "no unix account '${AGENTOS_ACCOUNT}' on this host — leaving ${inbox} unowned; the node cannot write update pokes and will fall back to the six-hourly timer"
      inbox_owner=""; outbox_group=""
    fi
  fi
  # .env should STATE what this function actually created, rather than leave
  # every consumer on a default that happens to agree: compose interpolates
  # `${AGENTOS_SIGNAL_INBOX_HOST:-./signals}` for the mount source, the core
  # derives from AGENTOS_DIR (wiring.ts), the poller's unit is rendered from
  # these same keys, and this CLI defaults to /var/lib/<unit>/outbox. Four
  # independent defaults that line up today is not the same thing as one
  # recorded fact, and a node installed before these keys existed has none of
  # them — writing them here is what converges it on the state a fresh install
  # produces. Never CREATES .env (write_env_key refuses), and never rewrites a
  # key that already holds this value, so an unchanged node touches nothing.
  local env_warned=0
  persist_signal_key() { # persist_signal_key <key> <value>
    [ -f "$AGENTOS_HOME/.env" ] || return 0
    [ "$(dotenv_val "$1")" = "$2" ] && return 0
    write_env_key "$1" "$2" && return 0
    # Once per run, not once per key: four identical lines about the same
    # unwritable file is noise, and this is best-effort either way.
    [ "$env_warned" = 1 ] || warn "could not record the update-signal paths in $AGENTOS_HOME/.env — the directories exist, but a consumer reading that file keeps its old value"
    env_warned=1
    return 0
  }
  # The guard is plain_dir_ok, at file scope above — one copy, shared with the
  # paths install.sh guards, because this rule drifting between the two files is
  # the standing hazard here. Refuse rather than `chown -h`-retarget: retargeting
  # as a SUBSTITUTE for refusing would leave the attacker's symlink in place and
  # the node quietly dead (the core cannot write through a link it does not own),
  # trading a loud failure for a silent one. `-h` IS on the chown below, but only
  # as a backstop on an already-verified directory — see the residual note there.
  # Skipping one directory is never fatal — the node keeps updating on the
  # six-hourly timer, which is what that timer is for.
  #
  # Guard, create, harden — per directory, in that order, one directory at a
  # time. Never `mkdir -p "$inbox" "$outbox"`, because one call fails as a unit:
  # an outbox that cannot be created (a read-only /var, an operator-chosen path)
  # took the inbox's chmod and chown down with it and returned, leaving exactly
  # the "the directory exists but the core cannot write to it" state this
  # function exists to prevent — and saying so in the vaguer of the two messages.
  #
  # And never batched — all the guards, then all the mkdirs, then all the chmods
  # — because batching WIDENS the one window that matters. Interleaved, exactly
  # one command (the mkdir) stands between a guard and the chmod it protects,
  # here and in install.sh's copy alike, and the suite reads both windows off an
  # xtrace so this cannot quietly stop being true. Batched, the outbox's chmod
  # trailed its guard by six: BOTH mkdirs, the inbox's chmod and chown, and the
  # two `sed`s of a persist — eight processes, since each of those `sed`s is
  # piped into a `tail`. Which is why the .env writes are now at the bottom,
  # after both directories are settled, instead of in between them.
  #
  # RESIDUAL, stated as what THIS CODE does and what a winner gets. This block
  # asserts nothing about what any tool offers on any platform: three such claims
  # were written here and two were wrong, and the versions that decide them
  # belong to the operator's host, not to us.
  #
  # A guard is a check and what follows is a separate process, so a swap in
  # between still wins the race. `chown -h` does not close it — nothing here
  # makes check-and-act atomic — and it is not the response to a planted symlink
  # either: refusing is, above. It runs on a directory just verified, where it is
  # a no-op except in the one case that matters, and what it changes is what
  # LOSING costs. Lost with it, the ownership change lands on the link itself and
  # the target keeps its own uid/gid. Lost without it, root hands the service
  # account whatever the link named, and /etc/systemd/system is every unit root
  # runs.
  #
  # The chmod is a plain chmod on that same just-verified path, so a link swapped
  # in before it runs IS followed. What that wins an attacker: a target that was
  # tighter, widened to 0750 — a confidentiality loss, and a denial of service
  # against anything relying on the old mode. What it does not win: ownership,
  # which does not move; or privilege, because the mode this code passes carries
  # no special digit and so cannot ADD setuid or setgid to anything. (Only that
  # half is claimed. Whether such a bit already on the target survives is a
  # question about the host's chmod, and this block does not answer those.)
  # Which is why the chmod goes first, while the guard's answer is newest, and
  # why that ordering is pinned by a test rather than left to prose. Closing the
  # window needs a chmod that does not follow the link; this code does not
  # attempt one.
  local have_inbox=1 have_outbox=1
  plain_dir_ok "$inbox" "update-signal inbox" || have_inbox=0
  if [ "$have_inbox" = 1 ] && ! mkdir -p "$inbox" 2>/dev/null; then
    warn "could not create the update-signal inbox ($inbox) — the node cannot write update pokes and will keep updating on the six-hourly timer"
    have_inbox=0
  fi
  if [ "$have_inbox" = 1 ]; then
    chmod 0750 "$inbox" 2>/dev/null || true
    if [ -n "$inbox_owner" ] && ! chown -h "$inbox_owner" "$inbox" 2>/dev/null; then
      fix="sudo chown $inbox_owner $inbox"
      warn "could not give $inbox to ${inbox_owner} — the node cannot write update pokes and will fall back to the six-hourly timer. Fix with: ${fix}"
    fi
  fi
  plain_dir_ok "$outbox" "update-signal outbox" || have_outbox=0
  if [ "$have_outbox" = 1 ] && ! mkdir -p "$outbox" 2>/dev/null; then
    warn "could not create the update-signal outbox ($outbox) — an unattended upgrade cannot report its outcome, so the owner will not be told how it went"
    have_outbox=0
  fi
  if [ "$have_outbox" = 1 ]; then
    chmod 0750 "$outbox" 2>/dev/null || true
    # Warned, not `|| true`: the inbox failure is announced and this one was
    # silent, against this function's own stated rule. An outbox that stayed
    # root-only is invisible to the core — result.json is written and never
    # read — so every unattended upgrade would land without a word to the owner.
    if [ -n "$outbox_group" ] && ! chown -h "root:${outbox_group}" "$outbox" 2>/dev/null; then
      fix="sudo chown root:${outbox_group} $outbox"
      warn "could not give $outbox to group ${outbox_group} — the node cannot read upgrade results, so unattended upgrades will complete without telling the owner. Fix with: ${fix}"
    fi
  fi
  # .env last, once both directories are settled. These are two `sed`s apiece,
  # and between a guard and the chmod it protects is the one place they must not
  # run.
  if [ "$have_inbox" = 1 ]; then
    persist_signal_key AGENTOS_SIGNAL_INBOX "$inbox"
    # docker only: the key compose interpolates for the mount SOURCE. On bare
    # metal there is no mount and install.sh writes no such key, so inventing
    # one here would put a second name for the same idea in the file.
    [ "$mode" = docker ] && persist_signal_key AGENTOS_SIGNAL_INBOX_HOST "$inbox"
  fi
  if [ "$have_outbox" = 1 ]; then
    persist_signal_key AGENTOS_SIGNAL_OUTBOX "$outbox"
    [ "$mode" = docker ] && persist_signal_key AGENTOS_SIGNAL_OUTBOX_HOST "$outbox"
  fi
  return 0
}

# ─── docker mode: data-volume backup/restore ────────────────────────────────
#
# Mirrors scripts/agentos-upgrade.sh:88-160 (backup_now / restore_backup): a
# throwaway alpine container mounts the SAME named volume the node uses for
# /data (messages.db + its WAL sidecars + .aop state) and tars it out while the
# node is STOPPED, so the copy is consistent and not a torn read of a live
# SQLite. AGENTOS_KEEP_BACKUPS (default 5) prunes the oldest archives. Under
# managed PostgreSQL (DATABASE_URL set) this is a deliberate no-op — see
# uses_managed_postgres() above.
#
# Rollback pairing (same contract as systemd mode below): every archive
# carries a ".image" sidecar recording the image its DATA belongs to, and
# docker_upgrade is the ONLY place that ever repoints
# $BACKUP_DIR/.last-upgrade — the single pointer docker_rollback reads — at
# the archive it just took, before the image flip. A standalone
# `agentos backup` (docker_backup) calls the same docker_backup_sqlite
# helper but never touches .last-upgrade, so a routine backup can never
# change what `agentos rollback` restores.

docker_data_volume() { # → docker volume name backing /data
  local vol
  vol="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' agentos-node 2>/dev/null || true)"
  [ -n "$vol" ] || vol="$(basename "$AGENTOS_HOME")_agentos-data"
  printf '%s' "$vol"
}

docker_prune_backups() { # AGENTOS_KEEP_BACKUPS (default 5) — never removes the archive $BACKUP_DIR/.last-upgrade points at (or its sidecar), regardless of age, so routine backup churn can't strand a pending rollback
  local keep="${AGENTOS_KEEP_BACKUPS:-5}" n protect=""
  [ -f "$BACKUP_DIR/.last-upgrade" ] && protect="$(basename "$(cat "$BACKUP_DIR/.last-upgrade" 2>/dev/null || true)")"
  n="$(ls -1t "$BACKUP_DIR"/agentos-*.tar.gz 2>/dev/null | wc -l | tr -d ' ')"
  [ "${n:-0}" -le "$keep" ] && return 0
  ls -1t "$BACKUP_DIR"/agentos-*.tar.gz | tail -n +"$((keep + 1))" | while IFS= read -r old; do
    [ -n "$protect" ] && [ "$(basename "$old")" = "$protect" ] && continue
    rm -f "$old" "${old%.tar.gz}.image"
    info "pruned $(basename "$old")"
  done
}

docker_backup_sqlite() { # stop → tar /data out → prune; prints the archive path last (nothing if managed Postgres)
  if uses_managed_postgres; then
    warn "DATABASE_URL is set: skipping local SQLite backup (managed PostgreSQL backups are external)." >&2
    return 0
  fi
  mkdir -p "$BACKUP_DIR"
  local stamp out vol image
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$BACKUP_DIR/agentos-${stamp}.tar.gz"
  vol="$(docker_data_volume)"
  image="$(grep -E '^AGENTOS_IMAGE=' "$AGENTOS_HOME/.env" 2>/dev/null | cut -d= -f2- || true)"
  step "Backing up"
  ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" stop node ) >/dev/null 2>&1 || true
  docker run --rm -v "$vol":/data:ro -v "$BACKUP_DIR":/backup alpine:3 \
    tar czf "/backup/$(basename "$out")" -C /data . \
    || die "backup FAILED — refusing to continue with a node whose data we cannot restore."
  # sidecar records the image the DATA belongs to (pre-upgrade), same idea as
  # agentos-upgrade.sh's ".ref" file recording the pre-upgrade git commit.
  [ -n "$image" ] && printf '%s\n' "$image" > "${out%.tar.gz}.image"
  ok "backup: $(basename "$out") ($(du -h "$out" | cut -f1)) from volume '$vol'"
  docker_prune_backups
  printf '%s' "$out"
}

docker_restore_sqlite() { # docker_restore_sqlite <archive> — restores /data from an archive docker_backup_sqlite created
  local archive="${1:?docker_restore_sqlite needs an archive}" vol
  [ -f "$archive" ] || die "backup archive gone: $archive"
  vol="$(docker_data_volume)"
  ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" stop node ) >/dev/null 2>&1 || true
  # Wipe then unpack: a restore that merges into a newer schema's leftovers is
  # not a restore.
  docker run --rm -v "$vol":/data -v "$BACKUP_DIR":/backup:ro alpine:3 \
    sh -c 'rm -rf /data/* /data/.[!.]* 2>/dev/null; tar xzf "/backup/'"$(basename "$archive")"'" -C /data' \
    || die "restore FAILED — the backup is still at $archive, do not start the node."
  ok "restored $(basename "$archive")"
}

# ─── docker mode: upgrade / rollback / backup ───────────────────────────────

docker_upgrade() { # docker_upgrade [tag] [image-ref]  — empty tag = latest stable
  local to="${1:-}" image_ref="${2:-}" manifest image digest prev snap
  if [ -n "$image_ref" ]; then
    # Explicit, already-resolved ref (the autoupdate poller passes a
    # digest-pinned repo@sha256:… so the pull is immutable). Skip the manifest.
    image="$image_ref"
  else
    if [ -n "$to" ]; then
      manifest="$(curl -fsSL "https://github.com/${DIST_REPO}/releases/download/${to}/stable.json")" \
        || die "no stable.json for ${to}"
    else
      manifest="$(fetch_manifest)"
    fi
    image="$(printf '%s' "$manifest" | jq -r .image)"
    # Pin by DIGEST, never the moving tag: repo part of .image + @ + .digest. The
    # image IS the unit of distribution addressed by digest — a tag can be
    # repointed under us, a digest cannot. Manifests without a digest (older
    # GitHub-release stable.json) keep the tag ref unchanged.
    digest="$(printf '%s' "$manifest" | jq -r '.digest // empty')"
    [ -n "$digest" ] && image="${image%:*}@${digest}"
  fi
  prev="$(grep -E '^AGENTOS_IMAGE=' "$AGENTOS_HOME/.env" | cut -d= -f2-)"
  if [ "$image" = "$prev" ]; then
    echo "already at $image"
    # Same as the systemd branch: reconcile the units even when the image does
    # not move, so an operator who narrowed AGENTOS_AUTOUPDATE_POLICY in .env has
    # a command that carries it into the root poller's unit (which reads no .env
    # of its own). Docker mode keeps the templates in the install root, where
    # install.sh's `docker cp` of profiles/ put them.
    reconcile_units "$AGENTOS_HOME" || warn "unit reconciliation hit a snag"
    return 0
  fi
  # Managed PG: record the pre-flip restore point + shout that there is no
  # automatic rollback here, BEFORE anything changes. No-op on SQLite nodes.
  managed_pg_restore_point "$prev" "$image"
  snap="$(docker_backup_sqlite | tail -1)"   # consistent copy: the node is stopped
  [ -n "$snap" ] && echo "$snap" > "$BACKUP_DIR/.last-upgrade"   # pairs archive + pre-upgrade image (its .image sidecar), before the flip
  docker_set_image "$image"
  # BEFORE any `up`: the compose file this node runs may already carry the two
  # signal bind-mounts (a previous upgrade's docker_refresh_profiles installed
  # it), and a mount source docker has to invent is one the core cannot write.
  # Unconditional and idempotent, so a run whose chown failed last time retries.
  ensure_signal_dirs docker
  ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" pull && docker compose -f "$COMPOSE_FILE" up -d )
  if ! wait_healthz; then
    if uses_managed_postgres; then
      echo "new version unhealthy" >&2
      docker_managed_postgres_warning "$prev"
      die "refusing an unsafe automatic rollback in managed-PostgreSQL mode; inspect: docker compose -f $COMPOSE_FILE logs node"
    fi
    echo "new version unhealthy — rolling back" >&2
    docker_set_image "$prev"
    docker_restore_sqlite "$snap"
    ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" up -d )
    die "upgrade failed; previous version restored"
  fi
  # The node is live and healthy on the new image; now pull the operator tooling
  # (the CLI itself, the auto-update poller, the compose file) forward too, so
  # `agentos upgrade` upgrades itself and not merely the container (issue #112).
  # Best-effort: never let a refresh snag undo a good upgrade.
  docker_refresh_profiles "$image" "$prev" || warn "profile refresh hit a snag; the node upgrade itself succeeded"
  ok "upgraded: $prev → $image"
}

docker_rollback() { # undo the last recorded upgrade — database + image together, from the single .last-upgrade pair
  local archive image
  archive="$(cat "$BACKUP_DIR/.last-upgrade" 2>/dev/null || true)"
  if [ -z "$archive" ]; then
    if uses_managed_postgres; then
      docker_managed_postgres_warning
      die "refusing an unsafe rollback in managed-PostgreSQL mode."
    fi
    die "no upgrade recorded to roll back (missing $BACKUP_DIR/.last-upgrade); archives under $BACKUP_DIR (if any) can be restored by hand, but this command only ever undoes the last upgrade."
  fi
  [ -f "$archive" ] || die "backup archive gone: $archive"
  image="$(cat "${archive%.tar.gz}.image" 2>/dev/null || true)"
  step "Rolling back"
  info "database → $(basename "$archive")"
  [ -n "$image" ] && info "image    → $image"
  uses_managed_postgres && warn "DATABASE_URL is set — restoring the LOCAL backup only; the managed database is not part of it."
  docker_restore_sqlite "$archive"
  [ -n "$image" ] && docker_set_image "$image"
  ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" up -d )
  if wait_healthz; then
    ok "rolled back and healthy"
  else
    ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" logs --tail 30 node ) || true
    die "still unhealthy after rollback — the pre-upgrade state is at $archive."
  fi
}

docker_backup() { # manual, standalone backup — leaves the node running afterward
  local out
  out="$(docker_backup_sqlite | tail -1)"
  ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" up -d ) >/dev/null
  if ! wait_healthz; then
    ( cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" logs --tail 30 node ) || true
    die "node did not come back healthy after the backup stop/start cycle."
  fi
  if [ -n "$out" ]; then
    ok "backup: $out"
  else
    ok "node is healthy (no local backup taken — see the notice above)"
  fi
}

# ─── systemd mode: version + backup/restore helpers ────────────────────────
#
# Bare-metal self-host is SQLite-only by design: there is no volume to tar
# (docker mode's approach), so this backs up the SQLite files directly under
# a timestamped directory in $BACKUP_DIR and prunes old ones. Managed
# PostgreSQL (DATABASE_URL set) is the same deliberate no-op as
# uses_managed_postgres()/docker_managed_postgres_warning() describe for
# docker mode above — reused here rather than duplicated.
#
# Rollback pairing: a data snapshot and the code tag it was taken next to
# must never come apart. Every snapshot dir carries its OWN tag in a
# `version` file (systemd_backup_sqlite writes it unconditionally, whoever
# the caller is). systemd_upgrade is the ONLY place that ever repoints
# $BACKUP_DIR/.last-upgrade — the single pointer systemd_rollback reads —
# and it does so atomically with the snapshot it just took, before the
# symlink swap. A standalone `agentos backup` (systemd_backup) calls the
# same systemd_backup_sqlite helper but never touches .last-upgrade, so a
# routine backup can never change what `agentos rollback` restores. There is
# no separate `.last` pointer — the snapshot dir IS the record.

systemd_backup_sqlite() { # systemd_backup_sqlite <label> — <label> is the code tag this snapshot belongs next to. Prints the new dir's path on stdout (nothing if managed Postgres). Never touches .last-upgrade — callers decide that.
  if uses_managed_postgres; then
    warn "DATABASE_URL is set: skipping local SQLite backup (managed PostgreSQL backups are external)." >&2
    return 0
  fi
  local label="${1:?systemd_backup_sqlite needs a label}"
  local ts dest f
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dest="$BACKUP_DIR/${ts}-${label}"
  mkdir -p "$dest"
  for f in messages.db messages.db-wal messages.db-shm search.db; do
    [ -f "$AGENTOS_HOME/data/$f" ] && cp -a "$AGENTOS_HOME/data/$f" "$dest/"
  done
  # .aop/ is the agent run-state (in-flight run dirs, cursors) — docker mode
  # already captures it by tarring the whole /data volume, so bare metal must
  # snapshot it too or a rollback would strand the node with mismatched runs.
  [ -d "$AGENTOS_HOME/data/.aop" ] && cp -a "$AGENTOS_HOME/data/.aop" "$dest/"
  # Context registry metadata lives in messages.db; every per-context ledger and
  # local-only repository lives under contexts/. Snapshot the tree as a unit so
  # A/B workspaces, including unpushed local history, restore consistently.
  [ -d "$AGENTOS_HOME/data/contexts" ] && cp -a "$AGENTOS_HOME/data/contexts" "$dest/"
  echo "$label" > "$dest/version"
  ok "backup: $(basename "$dest")"
  systemd_prune_backups
  printf '%s' "$dest"
}

systemd_prune_backups() { # AGENTOS_KEEP_BACKUPS (default 5) — never removes the dir $BACKUP_DIR/.last-upgrade points at, regardless of age, so routine backup churn can't strand a pending rollback
  local keep="${AGENTOS_KEEP_BACKUPS:-5}" protect=""
  [ -f "$BACKUP_DIR/.last-upgrade" ] && protect="$(basename "$(cat "$BACKUP_DIR/.last-upgrade" 2>/dev/null || true)")"
  # Only AUTO snapshots are subject to keep-N retention. systemd_backup_sqlite
  # names them <UTC-timestamp>-<tag> (e.g. 20260807T211046Z-v2.30.1); a human's
  # deliberate backup (manual-<ts>-<label>, incident surgery) does NOT match that
  # shape and is NEVER counted toward keep-N nor pruned — auto-retention must not
  # eat a hand-made safety net. Filtering here (not just skipping in the loop)
  # also stops manual dirs from occupying keep-N slots and evicting real snapshots.
  ls -1dt "$BACKUP_DIR"/*/ 2>/dev/null \
    | grep -E '/[0-9]{8}T[0-9]{6}Z-[^/]+/?$' \
    | tail -n +"$((keep + 1))" | while IFS= read -r d; do
    [ -n "$protect" ] && [ "$(basename "$d")" = "$protect" ] && continue
    rm -rf "$d"
    info "pruned $(basename "$d")"
  done
}

systemd_restore_sqlite() { # systemd_restore_sqlite <snapshot-dir> — restores data/ from a dir systemd_backup_sqlite created
  if uses_managed_postgres; then
    docker_managed_postgres_warning
    die "refusing an unsafe rollback in managed-PostgreSQL mode."
  fi
  local src="${1:?systemd_restore_sqlite needs a snapshot dir}"
  [ -d "$src" ] || die "backup dir gone: $src"
  # Wipe the live run-state first so restore REPLACES .aop/ wholesale rather
  # than overlaying onto it — `cp -a` alone would leave any current run dir the
  # snapshot lacks in place, mixing old and new state. This mirrors docker mode,
  # which `rm -rf /data/*` before untarring the snapshot. Restoring a snapshot
  # taken before .aop/ existed therefore correctly leaves no .aop/ behind.
  rm -rf "$AGENTOS_HOME/data/.aop" "$AGENTOS_HOME/data/contexts"
  cp -a "$src"/. "$AGENTOS_HOME/data/"
  # The snapshots are root-owned (this CLI runs as root), and `cp -a` of
  # "<dir>/." carries the snapshot dir's OWN ownership onto data/ itself — the
  # rolled-back User=agentos node would then hit SQLITE_READONLY_DIRECTORY and
  # never start. Give the whole data dir back to the service account.
  chown -R "$AGENTOS_ACCOUNT:$AGENTOS_ACCOUNT" "$AGENTOS_HOME/data"
  ok "restored $(basename "$src")"
}

systemd_last_upgrade_dir() { # → the snapshot dir recorded by the most recent systemd_upgrade, validated to exist
  local src
  src="$(cat "$BACKUP_DIR/.last-upgrade" 2>/dev/null || true)"
  [ -n "$src" ] || die "no upgrade recorded to roll back (missing $BACKUP_DIR/.last-upgrade)"
  [ -d "$src" ] || die "backup dir gone: $src"
  printf '%s' "$src"
}

prune_versions() { # keep current + 2 previous version dirs under versions/ — always excludes the current symlink target and the .last-upgrade pair's version, regardless of age
  local cur="" last_upgrade_ver="" src
  [ -L "$AGENTOS_HOME/current" ] && cur="$(basename "$(readlink "$AGENTOS_HOME/current")")"
  if [ -f "$BACKUP_DIR/.last-upgrade" ]; then
    src="$(cat "$BACKUP_DIR/.last-upgrade" 2>/dev/null || true)"
    [ -n "$src" ] && [ -f "$src/version" ] && last_upgrade_ver="$(cat "$src/version" 2>/dev/null || true)"
  fi
  # The .last-upgrade protection exists to keep the DATABASE rollback target's
  # version tree. Under managed PostgreSQL no local snapshot is ever taken
  # (systemd_backup_sqlite is a deliberate no-op), so .last-upgrade NEVER
  # advances past the last SQLite-era snapshot — it freezes, and this protection
  # would then pin that one ancient version dir on disk forever (observed on a
  # managed-PG node: a v2.24.0 tree stranded across every later upgrade). And
  # `agentos rollback` is refused in managed mode anyway, so the pin guards
  # nothing real. Drop it there; the keep-newest-3 window below still retains the
  # current release plus the two most recent previous trees for a manual re-pin.
  if uses_managed_postgres; then last_upgrade_ver=""; fi
  ls -1dt "$AGENTOS_HOME/versions"/*/ 2>/dev/null | tail -n +4 | while IFS= read -r d; do
    local tag; tag="$(basename "$d")"
    [ "$tag" = "$cur" ] && continue
    [ -n "$last_upgrade_ver" ] && [ "$tag" = "$last_upgrade_ver" ] && continue
    rm -rf "$d"
  done
}

# ─── systemd mode: upgrade / rollback / backup ─────────────────────────────
#
# Mirrors the docker-mode contract above: fetch stable.json (or a pinned
# tag's, symmetric to docker_upgrade's --to handling), unpack the release
# tree into a versions/.tmp-<tag> staging dir and atomically `mv` it into
# versions/<tag> only once download + checksum + extract all succeeded — so
# `[ -d versions/$tag ]` can only ever be true for a complete, verified
# release, never a half-downloaded one; an EXIT trap cleans the staging dir
# on any failure (checksum mismatch, bad tarball, or a plain crash), so a
# retry starts from a clean slate. Then stop the unit, back up the SQLite
# data files, flip the `current` symlink, start the unit, and wait for
# /healthz. The schema boot-guard (apps/api/src/core/db/schema-guard.ts)
# refuses to start code older than the database it finds, so an unhealthy
# new version rolls back CODE AND DATABASE TOGETHER — a code-only rollback
# would leave the node unable to boot at all.

# Keep .env's AGENTOS_VERSION honest about which code is actually live. The
# symlink is the source of truth for WHICH TREE RUNS, but this value is not
# merely cosmetic: .env is the unit's EnvironmentFile and core/build-info.ts
# reads AGENTOS_VERSION ahead of the release tree's build-info.json, so
# whatever the process is started with is the version /info reports until it
# restarts. Every caller must therefore write it BEFORE `systemctl start`.
# Absent key => nothing to do; this never CREATES the key.
set_env_version() { # set_env_version <tag>
  local tag="$1" env_file="$AGENTOS_HOME/.env"
  [ -f "$env_file" ] || return 0
  grep -q '^AGENTOS_VERSION=' "$env_file" || return 0
  local tmp; tmp="$(mktemp)"
  sed "s|^AGENTOS_VERSION=.*|AGENTOS_VERSION=${tag}|" "$env_file" > "$tmp"
  cat "$tmp" > "$env_file"   # preserve the original file's owner/mode (0600)
  rm -f "$tmp"
}

systemd_upgrade() { # systemd_upgrade [tag]  — empty tag = latest stable
  local to="${1:-}" manifest tag tarball sha url prev tmp_dir snap started
  if [ -n "$to" ]; then
    manifest="$(curl -fsSL "https://github.com/${DIST_REPO}/releases/download/${to}/stable.json")" \
      || die "no stable.json for ${to}"
  else
    manifest="$(fetch_manifest)"
  fi
  tag="$(jq -r .version <<<"$manifest")"
  prev="$(basename "$(readlink "$AGENTOS_HOME/current")")"
  if [ "$tag" = "$prev" ]; then
    echo "already at $tag"
    # Not a no-op run: the unit set is reconciled here too. The auto-update
    # oneshot carries the policy and the signal paths that .env states — root
    # copies them in, because that unit reads no file the unprivileged core can
    # write — so THIS is the command an operator has after editing .env, and a
    # node already on the newest release is exactly the node that would
    # otherwise have no way to re-arm its poller short of re-running install.sh.
    # It also runs the policy.conf migration, which an up-to-date node needs as
    # much as any other. Idempotent: unchanged units mean no daemon-reload.
    reconcile_units "$AGENTOS_HOME/current/profiles" || warn "unit reconciliation hit a snag"
    reconcile_secret_reader_acls || warn "secret-reader ACL reconciliation hit a snag"
    return 0
  fi
  tarball="$(jq -r .tarball <<<"$manifest")"
  sha="$(jq -r .tarball_sha256 <<<"$manifest")"
  url="https://github.com/${DIST_REPO}/releases/download/${tag}/${tarball}"

  if [ ! -d "$AGENTOS_HOME/versions/$tag" ]; then
    step "Fetching $tag"
    tmp_dir="$AGENTOS_HOME/versions/.tmp-$tag"
    rm -rf "$tmp_dir"
    # Expand $tmp_dir NOW (still in scope) and bake the literal path into the
    # trap. Deferring expansion — trap 'rm -rf "$tmp_dir"' — breaks on the
    # failure path: under `set -u` the EXIT trap fires after this function's
    # `local` has unwound, so `$tmp_dir` is unbound (the trap aborts with
    # "tmp_dir: unbound variable" and the versions/.tmp-<tag> staging dir is
    # left behind after a failed unpack).
    trap "rm -rf '$tmp_dir'" EXIT
    mkdir -p "$tmp_dir"
    curl -fsSL "$url" -o "$tmp_dir/${tarball}"
    echo "${sha}  $tmp_dir/${tarball}" | sha256sum -c - || die "tarball checksum mismatch"
    tar --use-compress-program=unzstd -xf "$tmp_dir/${tarball}" -C "$tmp_dir"
    rm -f "$tmp_dir/${tarball}"
    trap - EXIT
    mv "$tmp_dir" "$AGENTOS_HOME/versions/$tag"   # atomic: versions/$tag only ever appears fully populated
  fi

  # The unpack above ran as root (this CLI needs root for systemctl anyway),
  # so the new tree is root-owned mode 700 — the User=agentos service cannot
  # even chdir into it (systemd 200/CHDIR). install.sh chown -R's the whole
  # install root on first install; mirror that for every version this CLI
  # materializes, BEFORE `current` ever points at it. Unconditional on
  # purpose: it also repairs a pre-existing root-owned dir from an older CLI.
  chown -R "$AGENTOS_ACCOUNT:$AGENTOS_ACCOUNT" "$AGENTOS_HOME/versions/$tag"

  step "Upgrading $prev → $tag"
  # Managed PG: record the pre-flip restore point + shout that there is no
  # automatic rollback here, BEFORE the unit is even stopped. No-op on SQLite.
  managed_pg_restore_point "$prev" "$tag"
  systemctl stop "$AGENTOS_SERVICE"
  snap="$(systemd_backup_sqlite "$prev" | tail -1)"   # consistent copy: the unit is stopped
  [ -n "$snap" ] && echo "$snap" > "$BACKUP_DIR/.last-upgrade"   # pairs snapshot + code tag atomically, before the swap
  ln -sfn "$AGENTOS_HOME/versions/$tag" "$AGENTOS_HOME/current"
  # Paired with the symlink flip, BEFORE the start — .env is the unit's
  # EnvironmentFile, so a process started against the old value keeps reporting
  # the PREVIOUS release (env outranks the release tree's build-info.json in
  # core/build-info.ts) for its entire life, and /info lies until the next
  # restart. The rollback branch below restores $prev the same way, also before
  # its start.
  set_env_version "$tag"
  # Also before the start, and for the same reason .env is: the core that reads
  # this inbox is the one about to boot. reconcile_units below would be too late
  # (it runs only after a healthy start, and returns early on a host with no
  # systemd) — and it is the unit set it installs, the .path watching this very
  # directory, that makes the inbox's absence matter.
  ensure_signal_dirs systemd
  # A start that fails to ACTIVATE (non-zero systemctl) must land in the same
  # rollback below as a failed healthz — a bare call here would abort under
  # set -e with the node down and no rollback.
  started=0
  if systemctl start "$AGENTOS_SERVICE"; then started=1; fi

  if [ "$started" = 1 ] && wait_healthz; then
    ok "upgraded: $prev → $tag"
    # Only now: the units belong to the release that is actually live, and the
    # branch below can still put $prev back. Best-effort — a snag here never
    # undoes an upgrade that is already healthy.
    reconcile_units "$AGENTOS_HOME/current/profiles" || warn "unit reconciliation hit a snag"
    reconcile_secret_reader_acls || warn "secret-reader ACL reconciliation hit a snag"
    prune_versions
  else
    if uses_managed_postgres; then
      echo "new version unhealthy" >&2
      docker_managed_postgres_warning "$prev"
      die "refusing an unsafe automatic rollback in managed-PostgreSQL mode; inspect: journalctl -u $AGENTOS_SERVICE"
    fi
    echo "unhealthy — rolling back to $prev (code + database)" >&2
    systemctl stop "$AGENTOS_SERVICE"
    systemd_restore_sqlite "$snap"
    ln -sfn "$AGENTOS_HOME/versions/$prev" "$AGENTOS_HOME/current"
    set_env_version "$prev"
    systemctl start "$AGENTOS_SERVICE" || true   # a failed activation IS a failed healthz below
    wait_healthz || die "rollback ALSO unhealthy — inspect: journalctl -u $AGENTOS_SERVICE"
    die "upgrade to $tag failed; $prev restored"
  fi
}

systemd_rollback() { # undo the last recorded upgrade — code + database together, from the single .last-upgrade pair
  if uses_managed_postgres; then
    docker_managed_postgres_warning
    die "refusing an unsafe rollback in managed-PostgreSQL mode."
  fi
  local src prev
  src="$(systemd_last_upgrade_dir)"
  prev="$(cat "$src/version" 2>/dev/null || true)"
  [ -n "$prev" ] || die "backup dir $src has no recorded version (corrupt snapshot)"
  [ -d "$AGENTOS_HOME/versions/$prev" ] || die "version dir gone: $AGENTOS_HOME/versions/$prev"
  step "Rolling back to $prev"
  systemctl stop "$AGENTOS_SERVICE"
  systemd_restore_sqlite "$src"
  ln -sfn "$AGENTOS_HOME/versions/$prev" "$AGENTOS_HOME/current"
  set_env_version "$prev"
  systemctl start "$AGENTOS_SERVICE" || true   # a failed activation IS a failed healthz below
  if wait_healthz; then
    ok "rolled back to $prev and healthy"
  else
    journalctl -u "$AGENTOS_SERVICE" -n 30 --no-pager || true
    die "still unhealthy after rollback — the pre-upgrade snapshot is at $src."
  fi
}

systemd_backup() { # manual, standalone backup — leaves the unit running afterward; NEVER touches .last-upgrade
  local tag out
  tag="$(basename "$(readlink "$AGENTOS_HOME/current")")"
  systemctl stop "$AGENTOS_SERVICE"
  out="$(systemd_backup_sqlite "$tag" | tail -1)"
  systemctl start "$AGENTOS_SERVICE" || true   # a failed activation IS a failed healthz below
  if ! wait_healthz; then
    journalctl -u "$AGENTOS_SERVICE" -n 30 --no-pager || true
    die "node did not come back healthy after the backup stop/start cycle."
  fi
  if [ -n "$out" ]; then
    ok "backup: $out"
  else
    ok "node is healthy (no local backup taken — see the notice above)"
  fi
}

# ─── command dispatch ────────────────────────────────────────────────────────

cmd_version() {
  case "$(detect_mode)" in
    systemd) readlink "$AGENTOS_HOME/current" | xargs basename ;;
    docker)  grep -E '^AGENTOS_IMAGE=' "$AGENTOS_HOME/.env" | cut -d= -f2- ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_status() {
  case "$(detect_mode)" in
    systemd) systemctl status "$AGENTOS_SERVICE" --no-pager ;;
    docker)  (cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" ps) ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_logs() {
  case "$(detect_mode)" in
    # The unit appends stdout+stderr to logs/node.log (agentos.service), so the
    # node's own log is readable from inside the instance sandbox without root.
    # Prefer it; fall back to the journal only if it is not there yet (an install
    # from before per-instance logging, or the very first moments before boot).
    systemd)
      local logfile="$AGENTOS_HOME/logs/node.log"
      if [ -r "$logfile" ]; then
        tail -n "${1:-200}" "$logfile"
      else
        journalctl -u "$AGENTOS_SERVICE" -n "${1:-200}" --no-pager
      fi ;;
    docker)  (cd "$AGENTOS_HOME" && docker compose -f "$COMPOSE_FILE" logs --tail "${1:-200}") ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_upgrade() {
  local to="" image_ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to)    to="${2:?--to needs a value}"; shift 2 ;;
      --image) image_ref="${2:?--image needs a value}"; shift 2 ;;
      # Skip the quiet-moment wait. The unattended updater passes it too: by the
      # time it invokes this CLI it has ALREADY run the same gate (and may have
      # come through the security / MAX_DEFERRAL escape), so re-gating here would
      # let a busy core defer root past the very ceiling that bounds it.
      --force) FORCE_RESTART=1; shift ;;
      *)       die "unknown upgrade option: $1 (try --help)" ;;
    esac
  done
  # An upgrade ends in a restart of the node whichever mode we are in, so the
  # guard belongs here — once — rather than in each mode's restart call.
  await_quiet_moment "upgrade"
  case "$(detect_mode)" in
    systemd)
      [ -n "$image_ref" ] && die "--image is docker-mode only; bare-metal ships a tarball channel (use --to <tag>)."
      systemd_upgrade "$to" ;;
    docker)  docker_upgrade "$to" "$image_ref" ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

# Unattended manifest-driven updater — the policy layer that decides WHETHER to
# call cmd_upgrade at all. Lives in the sibling agentos-autoupdate.sh (shipped
# next to this CLI in profiles/); this is the one entrypoint the systemd timer
# invokes so a node has a single `agentos` command surface.
cmd_autoupdate() {
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  local here; here="$(cd "$(dirname "$self")" && pwd)"
  local poller="$here/agentos-autoupdate.sh"
  [ -x "$poller" ] || die "autoupdater not found at $poller"
  # The poller's apply step runs `$AGENTOS_AUTOUPDATE_APPLY_CMD --to <tag>`. Its
  # built-in default is the BARE `agentos`, which exists on PATH only for the
  # DEFAULT slot — a named (--user) instance's CLI is `agentos-<name>` and plain
  # `agentos` is not installed, so auto-apply died with "agentos: command not
  # found" and NO named instance ever self-upgraded (the policy layer decided
  # `auto`, then the apply silently failed). Point the apply command at THIS very
  # CLI entrypoint — the same file now running, already carrying the instance's
  # AGENTOS_DIR/SERVICE/USER in its environment — so it upgrades the right node
  # whatever the instance is called, and the default slot keeps working too.
  # Still overridable: the test suite substitutes a recorder via this same var.
  # `--force`: the poller runs the activity gate itself before it decides to apply
  # (and bypasses it for a security release or a target that has waited out
  # MAX_DEFERRAL). Without this flag cmd_upgrade would gate a SECOND time and a
  # core writing "busy" forever could hold root off past its own ceiling.
  export AGENTOS_AUTOUPDATE_APPLY_CMD="${AGENTOS_AUTOUPDATE_APPLY_CMD:-$self upgrade --force}"
  exec "$poller" "$@"
}

# Plugin surface — two sibling tools, one `agentos plugin` front door:
#   • agentos-plugins.sh (RUNTIME): install/manage plugins declared in
#     .agentos/plugins.yaml — add|ls|rm|enable|disable|secret|update|slot.
#   • agentos-plugin.sh (AUTHORING): scaffold/validate a plugin dir — new|validate|list.
# Routing: the runtime subcommands (and `add` given an npm:/git:/path: source)
# go to the runtime tool; new/validate/list and a bare-dir `add` stay on the
# authoring tool, so both surfaces coexist without ambiguity. See
# docs/plugin-authoring.md.
cmd_plugin() {
  local here; here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  local runtime="$here/agentos-plugins.sh" authoring="$here/agentos-plugin.sh"
  local sub="${1:-}"
  case "$sub" in
    ls|rm|enable|disable|secret|update|slot)
      [ -x "$runtime" ] || die "plugin runtime tool not found at $runtime"
      exec "$runtime" "$@" ;;
    add)
      # A runtime source (npm:/git:/path:) among the args ⇒ runtime install;
      # otherwise the authoring `add <dir> --repo` copy.
      local a
      for a in "$@"; do
        case "$a" in npm:*|git:*|path:*)
          [ -x "$runtime" ] || die "plugin runtime tool not found at $runtime"
          exec "$runtime" "$@" ;;
        esac
      done
      [ -x "$authoring" ] || die "plugin tool not found at $authoring"
      exec "$authoring" "$@" ;;
    *)
      [ -x "$authoring" ] || die "plugin tool not found at $authoring"
      exec "$authoring" "$@" ;;
  esac
}

# Preset surface — the routine-preset gallery (docs/product/preset-registry-decision.md).
#   agentos preset ls | show <id> | add <id> [key=value ...]
# ls/show are pure catalog reads; add renders a preset into the context repo's
# .agentos/routines/ (via $AGENTOS_CONTEXT_REPO) so the reconciler picks it up
# and it ticks on schedule. Delegates to the compiled Node CLI shipped with the
# core (core/presets/cli.js); in docker mode it runs inside the node container,
# in systemd mode against the current release checkout.
cmd_preset() {
  case "$(detect_mode)" in
    docker)
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T node \
          node dist/core/presets/cli.js "$@" ) ;;
    systemd)
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/core/presets/cli.js" \
        "$base/apps/api/dist/core/presets/cli.js" \
        "$base/node_modules/@agent-os/api/dist/core/presets/cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "preset CLI not found under $base (is the node installed?)"
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_import_history() { # agentos import-history --from <path> --chat <id> [--dry-run ...]
  # One-shot data load: import a prior transport's chat history (a telegram-mcp
  # messages.db, or a jsonl export) into this node's messages schema. Runs the
  # SAME CLI the source repo ships, against the node's own primary + FTS sidecar.
  # ⚠ SQLite is single-writer — run with the node stopped (or target Postgres).
  case "$(detect_mode)" in
    docker)
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T node \
          node dist/ops/import-history-cli.js "$@" ) ;;
    systemd)
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/ops/import-history-cli.js" \
        "$base/apps/api/dist/ops/import-history-cli.js" \
        "$base/node_modules/@agent-os/api/dist/ops/import-history-cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "import-history CLI not found under $base (is the node installed?)"
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_rollback() {
  case "$(detect_mode)" in
    systemd) systemd_rollback ;;
    docker)  docker_rollback ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

cmd_backup() {
  case "$(detect_mode)" in
    systemd) systemd_backup ;;
    docker)  docker_backup ;;
    none)    die "no install found under $AGENTOS_HOME" ;;
  esac
}

usage() {
  cat <<'EOF'
agentos — operate an AgentOS Core node
  install [installer flags]   fresh install (delegates to install.sh)
  upgrade [--to <tag>|--image <ref>] [--force]
                              upgrade to the stable channel, a pinned tag, or an
                              explicit (digest-pinned) image ref. Waits for a
                              quiet moment first (the node drains agent turns on
                              stop); --force restarts into a live turn anyway
  autoupdate [--check]        poll the update channel and apply per policy
                              (--check: report the verdict, change nothing)
  rollback                    undo the last upgrade (code + database)
  backup                      take a manual backup without upgrading
  plugin add|ls|rm|enable|disable|secret|update|slot ...  manage runtime plugins
  plugin new|validate|list ...  author, validate and scaffold plugin dirs
  preset ls | show <id> | add <id> [key=value ...]  browse + install routine presets
  import-history --from <path> --chat <id> [--dry-run]  import prior-transport
                              chat history into this node (messages.db | jsonl)
  status | logs [n] | version
EOF
}

case "${1:-}" in
  install)    shift; exec bash <(curl -fsSL "https://raw.githubusercontent.com/${DIST_REPO}/main/install.sh") "$@" ;;
  upgrade)    shift; cmd_upgrade "$@" ;;
  autoupdate) shift; cmd_autoupdate "$@" ;;
  rollback)   cmd_rollback ;;
  plugin)     shift; cmd_plugin "$@" ;;
  preset)     shift; cmd_preset "$@" ;;
  import-history) shift; cmd_import_history "$@" ;;
  status)   cmd_status ;;
  logs)     shift || true; cmd_logs "${1:-200}" ;;
  version)  cmd_version ;;
  backup)   cmd_backup ;;
  *)        usage; exit 1 ;;
esac
