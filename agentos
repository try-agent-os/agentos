# Shared-state surface — the counters two routines hold in common
# (ClickUp 12418agezg7).
#   agentos state ls | get <scope.key> | set <scope.key> <value>
#                    | incr <scope.key> [--by N] | cas <scope.key> <value> --expect <old>
#                    | history [<scope.key>]
# `incr` and `cas` are ATOMIC: the node decides the winner in one conditional
# UPDATE, which is the whole reason this is not a file in the context repo.
# A routine `command:` step calls the same CLI, and the engine hands that step
# the routine's declared write list in the environment — so a step can only
# write what its file declares. From a shell here the caller is the owner and
# may seed any key; every write is recorded in the state history either way.
# Delegates to the compiled Node CLI (core/routines/state-cli.js), exactly like
# `agentos routines`.
#
# Docker mode passes the AGENTOS_STATE_* variables through with `-e`: inside a
# routine step they ARE the contract, and dropping them at the container edge
# would silently promote a step to owner authority.
cmd_state() {
  case "$(detect_mode)" in
    docker)
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T \
          -e AGENTOS_STATE_DB -e AGENTOS_STATE_WRITES -e AGENTOS_STATE_ACTOR \
          -e AGENTOS_ROUTINE_RUN_ID -e AGENTOS_INSTALLATION_ID \
          node node dist/core/routines/state-cli.js "$@" ) ;;
    systemd)
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/core/routines/state-cli.js" \
        "$base/apps/api/dist/core/routines/state-cli.js" \
        "$base/node_modules/@agent-os/api/dist/core/routines/state-cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "state CLI not found under $base (is the node installed?)"
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

# Export one .env value into this process ONLY when the caller has not already
# set it. An explicit value in the environment therefore wins, so a second
# contour can be addressed by exporting its key without editing any file.
# Presence is tested with `${name:+set}`, never `${name:-}`: the latter would
# print the variable's VALUE, and one of these three is the node's key.
ctl_env_default() { # ctl_env_default KEY
  local key="$1" found
  [ -n "${!key:+set}" ] && return 0
  found="$(dotenv_val "$key")"
  [ -n "$found" ] && export "$key=$found"
  return 0
}

# Node-control surface — `agentos ctl` (task 12418agf323).
#   agentos ctl status | doctor | routine … | runs … | task … | settings … |
#           harness … | secret set … | restart | logs [n]
# The sub-mode that operates a RUNNING node from an ordinary shell, with no
# agent session and no LLM spend. Everything except `logs` goes through the
# core's loopback tool surface (never the database: SQLite is single-writer, and
# a second writer beside a live core is a second source of truth about one node),
# so the work is done by the compiled Node CLI — same three-path probe as
# `agentos preset` and `agentos routines`.
#
# `logs` is the deliberate exception and stays HERE: the node's stdout belongs to
# the supervisor, not to the node, so asking the core for its own log fails in
# exactly the case that matters — a core too sick to answer. It is the same
# reader `agentos logs` already is.
cmd_ctl() {
  if [ "${1:-}" = "logs" ]; then
    shift
    # `ctl logs tail 200` and `ctl logs 200` mean the same thing; the word is
    # accepted because the task names the verb that way, and an operator who
    # types it should get their log, not a usage error.
    [ "${1:-}" = "tail" ] && shift
    cmd_logs "${1:-200}"
    return
  fi
  case "$(detect_mode)" in
    docker)
      # The container already carries the node's environment, so nothing is
      # exported here. -T keeps stdin a pipe, which `ctl secret set` needs.
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T node \
          node dist/core/ctl/cli.js "$@" ) ;;
    systemd)
      # The CLI reads the node key and the endpoint from the ENVIRONMENT, and an
      # ssh shell has neither: they live in the node's own .env, readable by the
      # contour user alone. Lift exactly the three variables it needs.
      ctl_env_default AGENTOS_NODE_KEY
      ctl_env_default AGENTOS_PEER_ENDPOINT_FILE
      ctl_env_default MCP_PORT
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/core/ctl/cli.js" \
        "$base/apps/api/dist/core/ctl/cli.js" \
        "$base/node_modules/@agent-os/api/dist/core/ctl/cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "ctl CLI not found under $base (is the node installed?)"
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

# Durable sessions — `agentos sessions` (task U3, alias `agentos session`).
#   agentos sessions create|ls|status|attach|steer|stop|resume|budget …
# The job API for durable agent sessions: the SAME `/api/v1/sessions` contract an
# HTTP caller speaks, so a script, an operator and the node's own MCP tools all
# name one set of sessions with one set of receipts. Never the database — a
# durable control command must reach the RUNNING node, because the node is what
# holds the execution the command is about.
#
# Same three-path probe and the same credential lift as `ctl`: the key and the
# endpoint live in the node's own .env, readable by the contour user alone, and
# the CLI refuses to take a key from argv (/proc is world-readable).
cmd_sessions() {
  case "$(detect_mode)" in
    docker)
      # -T keeps stdin a pipe; `attach` streams until the operator detaches.
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T node \
          node dist/core/sessions/cli.js "$@" ) ;;
    systemd)
      ctl_env_default AGENTOS_NODE_KEY
      ctl_env_default AGENTOS_PEER_ENDPOINT_FILE
      ctl_env_default MCP_PORT
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/core/sessions/cli.js" \
        "$base/apps/api/dist/core/sessions/cli.js" \
        "$base/node_modules/@agent-os/api/dist/core/sessions/cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "sessions CLI not found under $base (is the node installed?)"
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

# MCP surface — this node, served to an EXTERNAL agent (task 12418agf324).
#   agentos mcp [--profile read|write] [--label <name>] [--print-surface]
# The second sub-mode of this one command, next to the operator subcommands
# above: `codex mcp`'s shape, where the same binary raises an MCP server instead
# of driving a session. It does NOT start a node — the node keeps running and
# owns its database; this is a stdio bridge onto its loopback tool surface, so a
# foreign agent mounts it with {"command":"agentos","args":["mcp"]}.
#
# ⚠ STDOUT IS THE PROTOCOL here. Nothing in this arm may echo to stdout — no
# warn(), no progress line — or the JSON-RPC framing is corrupt and the client
# reports a broken server with no clue why. die() writes to stderr and is fine.
#
# The credential is AGENTOS_NODE_KEY, and it is taken from the ENVIRONMENT, never
# from argv (which is world-readable in /proc). We lift it — and the endpoint
# file — out of the node's .env when the caller has not already exported them,
# because the whole point is that a foreign agent's config is one word long.
cmd_mcp() {
  case "$(detect_mode)" in
    docker)
      # `exec -T` keeps stdin/stdout as a plain pipe pair, which is exactly what
      # an MCP stdio client needs; a TTY would corrupt the framing.
      #
      # The label must be forwarded EXPLICITLY: `docker compose exec` does not
      # inherit the caller's environment into the container, so without `-e` the
      # client's chosen name is dropped and every docker-mode agent shows up in
      # the contour journal under the same default — the one field the audit
      # trail has for answering "who". The node key and endpoint are already in
      # the container's own environment, so only this one needs carrying.
      ( cd "$AGENTOS_HOME" && exec docker compose -f "$COMPOSE_FILE" exec -T \
          ${AGENTOS_MCP_CLIENT_LABEL:+-e "AGENTOS_MCP_CLIENT_LABEL=$AGENTOS_MCP_CLIENT_LABEL"} \
          node node dist/core/mcp/cli.js "$@" ) ;;
    systemd)
      local base="$AGENTOS_HOME/current" cli=""
      for c in \
        "$base/dist/core/mcp/cli.js" \
        "$base/apps/api/dist/core/mcp/cli.js" \
        "$base/node_modules/@agent-os/api/dist/core/mcp/cli.js"; do
        [ -f "$c" ] && { cli="$c"; break; }
      done
      [ -n "$cli" ] || die "mcp CLI not found under $base (is the node installed?)"
      [ -n "${AGENTOS_NODE_KEY:-}" ] || AGENTOS_NODE_KEY="$(dotenv_val AGENTOS_NODE_KEY)"
      [ -n "${AGENTOS_PEER_ENDPOINT_FILE:-}" ] || \
        AGENTOS_PEER_ENDPOINT_FILE="$(dotenv_val AGENTOS_PEER_ENDPOINT_FILE)"
      [ -n "$AGENTOS_NODE_KEY" ] || die "AGENTOS_NODE_KEY is not set and not readable from $AGENTOS_HOME/.env"
      export AGENTOS_NODE_KEY AGENTOS_PEER_ENDPOINT_FILE
      export AGENTOS_DIR="${AGENTOS_DIR:-$AGENTOS_HOME}"
      [ -n "${AGENTOS_MCP_CLIENT_LABEL:-}" ] && export AGENTOS_MCP_CLIENT_LABEL
      exec node "$cli" "$@" ;;
    none)
      die "no install found under $AGENTOS_HOME" ;;
  esac
}

